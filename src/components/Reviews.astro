---
import { reviews } from "../data/reviews";
---

<section class="band band--dark rv" id="reviews">
  <div class="wrap rv__head">
    <div data-reveal>
      <p class="tag tag--pale">What comes back</p>
      <h2>Your name is on the referral too.</h2>
    </div>
    <div class="rv__source" data-reveal style="--delay:120ms">
      <p class="lede rv__intro">
        Which is the real reason to be fussy about where you send him. These
        are his patients, in their own words, after the fact.
      </p>
      <p class="rv__badge">
        <span class="glogo" aria-hidden="true">
          <svg viewBox="0 0 48 48">
            <path
              fill="#4285F4"
              d="M45.12 24.5c0-1.56-.14-3.06-.4-4.5H24v8.51h11.84c-.51 2.75-2.06 5.08-4.39 6.64v5.52h7.11c4.16-3.83 6.56-9.47 6.56-16.17z"
            ></path>
            <path
              fill="#34A853"
              d="M24 46c5.94 0 10.92-1.97 14.56-5.33l-7.11-5.52c-1.97 1.32-4.49 2.1-7.45 2.1-5.73 0-10.58-3.87-12.31-9.07H4.34v5.7C7.96 41.07 15.4 46 24 46z"
            ></path>
            <path
              fill="#FBBC05"
              d="M11.69 28.18C11.25 26.86 11 25.45 11 24s.25-2.86.69-4.18v-5.7H4.34C2.85 17.09 2 20.45 2 24s.85 6.91 2.34 9.88l7.35-5.7z"
            ></path>
            <path
              fill="#EA4335"
              d="M24 10.75c3.23 0 6.13 1.11 8.41 3.29l6.31-6.31C34.91 4.18 29.93 2 24 2 15.4 2 7.96 6.93 4.34 14.12l7.35 5.7c1.73-5.2 6.58-9.07 12.31-9.07z"
            ></path>
          </svg>
        </span>
        Reviews from Google
      </p>
    </div>
  </div>

  <div class="rv__viewport">
    <div
      class="rv__track"
      data-rv-track
      tabindex="0"
      role="region"
      aria-label="Patient reviews from Google, scrollable"
    >
      {
        reviews.map((r) => (
          <article class="gcard">
            <header class="gcard__top">
              <span class="gcard__avatar" style={`--tint:${r.tint}`} aria-hidden="true">
                {r.initial}
              </span>
              <span class="gcard__who">
                <span class="gcard__name">{r.name}</span>
                <span class="gcard__meta">
                  {r.localGuide && <span class="gcard__guide">Local Guide</span>}
                  {r.localGuide && " · "}
                  {r.reviews}
                  {r.photos && ` · ${r.photos}`}
                </span>
              </span>
              <span class="gcard__g" aria-hidden="true">
                <svg viewBox="0 0 48 48">
                  <path
                    fill="#4285F4"
                    d="M45.12 24.5c0-1.56-.14-3.06-.4-4.5H24v8.51h11.84c-.51 2.75-2.06 5.08-4.39 6.64v5.52h7.11c4.16-3.83 6.56-9.47 6.56-16.17z"
                  ></path>
                  <path
                    fill="#34A853"
                    d="M24 46c5.94 0 10.92-1.97 14.56-5.33l-7.11-5.52c-1.97 1.32-4.49 2.1-7.45 2.1-5.73 0-10.58-3.87-12.31-9.07H4.34v5.7C7.96 41.07 15.4 46 24 46z"
                  ></path>
                  <path
                    fill="#FBBC05"
                    d="M11.69 28.18C11.25 26.86 11 25.45 11 24s.25-2.86.69-4.18v-5.7H4.34C2.85 17.09 2 20.45 2 24s.85 6.91 2.34 9.88l7.35-5.7z"
                  ></path>
                  <path
                    fill="#EA4335"
                    d="M24 10.75c3.23 0 6.13 1.11 8.41 3.29l6.31-6.31C34.91 4.18 29.93 2 24 2 15.4 2 7.96 6.93 4.34 14.12l7.35 5.7c1.73-5.2 6.58-9.07 12.31-9.07z"
                  ></path>
                </svg>
              </span>
            </header>

            <p class="gcard__rating">
              <span class="gcard__stars" aria-hidden="true">
                {[0, 1, 2, 3, 4].map(() => (
                  <svg viewBox="0 0 24 24" class="star">
                    <path d="M12 2.6l2.9 5.9 6.5.95-4.7 4.58 1.11 6.47L12 17.45 6.19 20.5 7.3 14.03 2.6 9.45l6.5-.95L12 2.6z" />
                  </svg>
                ))}
              </span>
              <span class="gcard__sr">Rated {r.rating} out of 5</span>
              <span class="gcard__when">{r.when}</span>
            </p>

            <div class="gcard__body" data-rv-body>
              {r.body.map((para) => (
                <p>{para}</p>
              ))}
            </div>

            <button class="gcard__more" type="button" data-rv-more hidden>
              Read more
            </button>
          </article>
        ))
      }
    </div>
  </div>

  <div class="wrap rv__controls">
    <div class="rv__buttons">
      <button type="button" data-rv-prev aria-label="Previous review">
        <span aria-hidden="true">←</span>
      </button>
      <button type="button" data-rv-next aria-label="Next review">
        <span aria-hidden="true">→</span>
      </button>
      <button
        type="button"
        class="rv__play"
        data-rv-play
        aria-label="Pause automatic scrolling"
        aria-pressed="false"
      >
        <span class="rv__play-icon" aria-hidden="true"></span>
      </button>
    </div>

    <ol class="rv__dots" data-rv-dots>
      {
        reviews.map((r, i) => (
          <li>
            <button
              type="button"
              data-rv-dot={i}
              aria-label={`Go to review ${i + 1} of ${reviews.length}, ${r.name}`}
            />
          </li>
        ))
      }
    </ol>
  </div>
</section>

<script>
  const track = document.querySelector<HTMLElement>("[data-rv-track]");

  if (track) {
    const cards = [...track.querySelectorAll<HTMLElement>(".gcard")];
    const prev = document.querySelector<HTMLButtonElement>("[data-rv-prev]");
    const next = document.querySelector<HTMLButtonElement>("[data-rv-next]");
    const play = document.querySelector<HTMLButtonElement>("[data-rv-play]");
    const dots = [...document.querySelectorAll<HTMLButtonElement>("[data-rv-dot]")];

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

    /* ---- clamp long reviews, with a per-card expander ---------------- */
    for (const card of cards) {
      const body = card.querySelector<HTMLElement>("[data-rv-body]");
      const more = card.querySelector<HTMLButtonElement>("[data-rv-more]");
      if (!body || !more) continue;
      // only offer the toggle when the text is actually clipped
      if (body.scrollHeight > body.clientHeight + 4) {
        more.hidden = false;
        more.addEventListener("click", () => {
          const open = card.classList.toggle("is-open");
          more.textContent = open ? "Show less" : "Read more";
          pause();
        });
      }
    }

    /* ---- position helpers -------------------------------------------
     * Several cards are visible at once, so the number of reachable
     * positions is not the number of cards: the last card can never scroll
     * to the left edge. Model it as pages, or the trailing dots are dead.
     */
    const stepOf = () => {
      const a = cards[0]?.getBoundingClientRect().width ?? track.clientWidth;
      const gap = parseFloat(getComputedStyle(track).columnGap || "0") || 0;
      return a + gap;
    };

    const maxScroll = () => Math.max(0, track.scrollWidth - track.clientWidth);

    const pageCount = () => {
      // clientWidth includes the track's inline padding, which is large on
      // wide screens — measure the content box or perView over-counts and
      // the final stretch of the track becomes unreachable by dot.
      const cs = getComputedStyle(track);
      const inner =
        track.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
      const perView = Math.max(1, Math.round(inner / stepOf()));
      return Math.max(1, cards.length - perView + 1);
    };

    const indexOf = () =>
      Math.min(pageCount() - 1, Math.round(track.scrollLeft / stepOf()));

    const goTo = (i: number, smooth = true) => {
      const last = pageCount() - 1;
      const clamped = Math.max(0, Math.min(last, i));
      track.scrollTo({
        left: Math.min(clamped * stepOf(), maxScroll()),
        behavior: smooth && !reduced.matches ? "smooth" : "auto",
      });
    };

    /* ---- autoplay ----------------------------------------------------
     * `wanted` is the user's intent; `running` is whether the interval is
     * actually live. Reduced motion sets the *initial* intent to off, but it
     * must never veto an explicit press of the play control — someone
     * clicking play is asking for motion.
     */
    let timer: number | undefined;
    let running = false;
    let inView = false;
    let wanted = !reduced.matches;

    const paint = () => {
      play?.classList.toggle("is-paused", !wanted);
      play?.setAttribute("aria-pressed", String(!wanted));
      play?.setAttribute(
        "aria-label",
        wanted ? "Pause automatic scrolling" : "Resume automatic scrolling"
      );
    };

    const tick = () => {
      const n = indexOf() + 1;
      goTo(n > pageCount() - 1 ? 0 : n);
    };

    // reconcile the timer with intent + visibility
    const reconcile = () => {
      const should = wanted && inView;
      if (should && !running) {
        timer = window.setInterval(tick, 6000);
        running = true;
      } else if (!should && running) {
        window.clearInterval(timer);
        timer = undefined;
        running = false;
      }
      paint();
    };

    // any deliberate handling of the carousel hands control to the reader
    const pause = () => {
      if (!wanted) return;
      wanted = false;
      reconcile();
    };

    play?.addEventListener("click", () => {
      wanted = !wanted;
      reconcile();
    });

    // NB: no wheel listener. Scrolling the page with the pointer over the
    // track is not an interaction with the carousel, and killing autoplay
    // on it meant the thing never appeared to move at all.
    track.addEventListener("pointerdown", pause);
    track.addEventListener("focusin", pause);
    prev?.addEventListener("click", () => {
      pause();
      goTo(indexOf() - 1);
    });
    next?.addEventListener("click", () => {
      pause();
      goTo(indexOf() + 1);
    });
    dots.forEach((d, i) =>
      d.addEventListener("click", () => {
        pause();
        goTo(i);
      })
    );

    /* ---- state sync -------------------------------------------------- */
    const sync = () => {
      const i = indexOf();
      const pages = pageCount();
      if (prev) prev.disabled = track.scrollLeft <= 4;
      if (next) next.disabled = track.scrollLeft >= maxScroll() - 4;
      dots.forEach((d, n) => {
        // hide dots for positions that cannot be scrolled to
        const li = d.parentElement;
        if (li) li.hidden = n >= pages;
        d.classList.toggle("is-on", n === i);
        if (n === i) d.setAttribute("aria-current", "true");
        else d.removeAttribute("aria-current");
      });
    };
    sync();
    track.addEventListener("scroll", sync, { passive: true });
    window.addEventListener("resize", sync);

    /* ---- only run while on screen ------------------------------------ */
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) inView = e.isIntersecting;
        reconcile();
      },
      { threshold: 0.3 }
    );
    io.observe(track);

    // turning the preference on mid-session should stop it; turning it off
    // should not silently start it
    reduced.addEventListener?.("change", () => {
      if (reduced.matches) pause();
    });

    paint();
  }
</script>

<style>
  .rv {
    overflow: hidden;
  }

  .rv__head {
    display: grid;
    gap: 1.5rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .rv__head h2 {
    margin-top: 0.4em;
    max-width: 16ch;
  }

  .rv__intro {
    max-width: 44ch;
  }

  .rv__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    margin-top: 1.2rem;
    padding: 0.5em 0.95em;
    background: color-mix(in srgb, var(--bone) 9%, transparent);
    border: 1px solid color-mix(in srgb, var(--bone) 18%, transparent);
    border-radius: 999px;
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--drape-pale);
  }

  .glogo,
  .gcard__g {
    display: block;
    flex: 0 0 auto;
  }

  .glogo svg {
    width: 14px;
    height: 14px;
    display: block;
  }

  @media (min-width: 62rem) {
    .rv__head {
      grid-template-columns: 1.1fr 0.9fr;
      align-items: end;
      gap: 3rem;
    }
  }

  /* ---------------------------------------------- carousel plumbing */
  .rv__viewport {
    position: relative;
  }

  .rv__track {
    --track-pad: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter)));
    display: flex;
    /* equal heights: a ragged row of cards reads as broken in a carousel,
       even though Google's own list varies */
    align-items: stretch;
    column-gap: 1.25rem;
    padding-inline: var(--track-pad);
    scroll-padding-inline: var(--track-pad);
    padding-bottom: 1.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .rv__track::-webkit-scrollbar {
    display: none;
  }

  /* ---------------------------------------------- the Google card */
  .gcard {
    position: relative;
    flex: 0 0 min(24rem, 84vw);
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    background: #fff;
    color: #202124;
    border-radius: 10px;
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.18),
      0 8px 26px -12px rgba(0, 0, 0, 0.45);
    transition: transform 0.5s var(--ease-out), box-shadow 0.5s var(--ease-out);
  }

  .gcard:hover {
    transform: translateY(-3px);
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.2),
      0 16px 36px -14px rgba(0, 0, 0, 0.55);
  }

  .gcard__top {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.75rem;
  }

  .gcard__avatar {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--tint);
    color: #fff;
    font-family: var(--body);
    font-size: 1.05rem;
    font-weight: 500;
    line-height: 1;
  }

  .gcard__who {
    display: grid;
    gap: 0.12rem;
    min-width: 0;
  }

  .gcard__name {
    font-size: 0.95rem;
    font-weight: 500;
    color: #202124;
  }

  .gcard__meta {
    font-size: 0.78rem;
    color: #70757a;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .gcard__guide {
    color: #5f6368;
  }

  .gcard__g svg {
    width: 17px;
    height: 17px;
    display: block;
  }

  .gcard__rating {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.9rem;
  }

  .gcard__stars {
    display: inline-flex;
    gap: 1px;
  }

  .star {
    width: 15px;
    height: 15px;
    fill: #fbbc04;
    display: block;
  }

  .gcard__when {
    font-size: 0.78rem;
    color: #70757a;
  }

  .gcard__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .gcard__body {
    margin-top: 0.85rem;
    font-size: 0.9rem;
    line-height: 1.6;
    color: #3c4043;
    /* Google clamps long reviews; so do we, with a real expander */
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 8;
    line-clamp: 8;
    overflow: hidden;
  }

  .gcard.is-open .gcard__body {
    -webkit-line-clamp: unset;
    line-clamp: unset;
    overflow: visible;
  }

  .gcard__body p + p {
    margin-top: 0.7rem;
  }

  .gcard__more {
    align-self: start;
    margin-top: 0.7rem;
    padding: 0;
    background: none;
    border: 0;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 500;
    color: #1a73e8;
    cursor: pointer;
  }

  .gcard__more:hover {
    text-decoration: underline;
  }

  /* ---------------------------------------------- controls */
  .rv__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.2rem;
    margin-top: 1.6rem;
  }

  .rv__buttons {
    display: flex;
    gap: 0.6rem;
  }

  .rv__buttons button {
    width: 2.9rem;
    height: 2.9rem;
    display: grid;
    place-items: center;
    font-size: 1rem;
    color: var(--bone);
    background: transparent;
    border: 1px solid color-mix(in srgb, var(--bone) 28%, transparent);
    border-radius: 50%;
    cursor: pointer;
    transition: background-color 0.3s var(--ease), opacity 0.3s var(--ease),
      border-color 0.3s var(--ease);
  }

  .rv__buttons button:hover:not(:disabled) {
    background: color-mix(in srgb, var(--bone) 12%, transparent);
    border-color: var(--iodine-bright);
  }

  .rv__buttons button:disabled {
    opacity: 0.3;
    cursor: default;
  }

  /* pause / play glyph drawn in CSS so it can morph */
  .rv__play-icon {
    position: relative;
    display: block;
    width: 10px;
    height: 12px;
  }

  .rv__play-icon::before,
  .rv__play-icon::after {
    content: "";
    position: absolute;
    top: 0;
    width: 3px;
    height: 12px;
    background: currentColor;
    transition: all 0.3s var(--ease);
  }

  .rv__play-icon::before {
    left: 0;
  }
  .rv__play-icon::after {
    right: 0;
  }

  /* paused -> show a play triangle */
  .rv__play.is-paused .rv__play-icon::before {
    left: 1px;
    width: 0;
    height: 0;
    border-top: 6px solid transparent;
    border-bottom: 6px solid transparent;
    border-left: 10px solid currentColor;
    background: transparent;
  }

  .rv__play.is-paused .rv__play-icon::after {
    opacity: 0;
  }

  .rv__dots {
    display: flex;
    gap: 0.45rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .rv__dots button {
    width: 7px;
    height: 7px;
    padding: 0;
    background: color-mix(in srgb, var(--bone) 30%, transparent);
    border: 0;
    border-radius: 50%;
    cursor: pointer;
    transition: background-color 0.35s var(--ease), transform 0.35s var(--ease-out);
  }

  .rv__dots button:hover {
    background: color-mix(in srgb, var(--bone) 60%, transparent);
  }

  .rv__dots button.is-on {
    background: var(--iodine-bright);
    transform: scale(1.5);
  }

  @media (prefers-reduced-motion: reduce) {
    .gcard,
    .rv__dots button {
      transition: none;
    }
  }
</style>
