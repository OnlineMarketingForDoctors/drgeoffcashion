---
import { getReviews } from "../sanity/queries";

const reviews = await getReviews();
---

<section class="band band--dark rv" id="reviews">
  <div class="wrap rv__head">
    <div data-reveal>
      <p class="tag tag--pale">What comes back</p>
      <h2>Your name is on the referral too.</h2>
    </div>
    <div class="rv__source" data-reveal style="--delay:120ms">
      <p class="lede rv__intro">
        Which is the real reason to be fussy about where you send him. These
        are his patients, in their own words, after the fact.
      </p>
      <p class="rv__badge">
        <span class="glogo" aria-hidden="true">
          <svg viewBox="0 0 48 48">
            <path
              fill="#4285F4"
              d="M45.12 24.5c0-1.56-.14-3.06-.4-4.5H24v8.51h11.84c-.51 2.75-2.06 5.08-4.39 6.64v5.52h7.11c4.16-3.83 6.56-9.47 6.56-16.17z"
            ></path>
            <path
              fill="#34A853"
              d="M24 46c5.94 0 10.92-1.97 14.56-5.33l-7.11-5.52c-1.97 1.32-4.49 2.1-7.45 2.1-5.73 0-10.58-3.87-12.31-9.07H4.34v5.7C7.96 41.07 15.4 46 24 46z"
            ></path>
            <path
              fill="#FBBC05"
              d="M11.69 28.18C11.25 26.86 11 25.45 11 24s.25-2.86.69-4.18v-5.7H4.34C2.85 17.09 2 20.45 2 24s.85 6.91 2.34 9.88l7.35-5.7z"
            ></path>
            <path
              fill="#EA4335"
              d="M24 10.75c3.23 0 6.13 1.11 8.41 3.29l6.31-6.31C34.91 4.18 29.93 2 24 2 15.4 2 7.96 6.93 4.34 14.12l7.35 5.7c1.73-5.2 6.58-9.07 12.31-9.07z"
            ></path>
          </svg>
        </span>
        Reviews from Google
      </p>
    </div>
  </div>

  <div class="rv__viewport">
    <div
      class="rv__track"
      data-rv-track
      tabindex="0"
      role="region"
      aria-label="Patient reviews from Google, scrollable"
    >
      {
        /* The set is rendered twice so the loop can wrap seamlessly. The
           second pass is hidden from assistive tech and made inert so it is
           neither announced nor focusable. */
        [...reviews, ...reviews].map((r, i) => (
          <article
            class="gcard"
            aria-hidden={i >= reviews.length ? "true" : undefined}
            inert={i >= reviews.length ? true : undefined}
          >
            <header class="gcard__top">
              <span class="gcard__avatar" style={`--tint:${r.tint}`} aria-hidden="true">
                {r.initial}
              </span>
              <span class="gcard__who">
                <span class="gcard__name">{r.name}</span>
                <span class="gcard__meta">
                  {r.localGuide && <span class="gcard__guide">Local Guide</span>}
                  {r.localGuide && " · "}
                  {r.reviews}
                  {r.photos && ` · ${r.photos}`}
                </span>
              </span>
              <span class="gcard__g" aria-hidden="true">
                <svg viewBox="0 0 48 48">
                  <path
                    fill="#4285F4"
                    d="M45.12 24.5c0-1.56-.14-3.06-.4-4.5H24v8.51h11.84c-.51 2.75-2.06 5.08-4.39 6.64v5.52h7.11c4.16-3.83 6.56-9.47 6.56-16.17z"
                  ></path>
                  <path
                    fill="#34A853"
                    d="M24 46c5.94 0 10.92-1.97 14.56-5.33l-7.11-5.52c-1.97 1.32-4.49 2.1-7.45 2.1-5.73 0-10.58-3.87-12.31-9.07H4.34v5.7C7.96 41.07 15.4 46 24 46z"
                  ></path>
                  <path
                    fill="#FBBC05"
                    d="M11.69 28.18C11.25 26.86 11 25.45 11 24s.25-2.86.69-4.18v-5.7H4.34C2.85 17.09 2 20.45 2 24s.85 6.91 2.34 9.88l7.35-5.7z"
                  ></path>
                  <path
                    fill="#EA4335"
                    d="M24 10.75c3.23 0 6.13 1.11 8.41 3.29l6.31-6.31C34.91 4.18 29.93 2 24 2 15.4 2 7.96 6.93 4.34 14.12l7.35 5.7c1.73-5.2 6.58-9.07 12.31-9.07z"
                  ></path>
                </svg>
              </span>
            </header>

            <p class="gcard__rating">
              <span class="gcard__stars" aria-hidden="true">
                {Array.from({ length: r.rating }, () => (
                  <svg viewBox="0 0 24 24" class="star">
                    <path d="M12 2.6l2.9 5.9 6.5.95-4.7 4.58 1.11 6.47L12 17.45 6.19 20.5 7.3 14.03 2.6 9.45l6.5-.95L12 2.6z" />
                  </svg>
                ))}
              </span>
              <span class="gcard__sr">Rated {r.rating} out of 5</span>
              <span class="gcard__when">{r.when}</span>
            </p>

            <div class="gcard__body" data-rv-body>
              {r.body.map((para) => (
                <p>{para}</p>
              ))}
            </div>

            <button class="gcard__more" type="button" data-rv-more hidden>
              Read more
            </button>
          </article>
        ))
      }
    </div>
  </div>

  <div class="wrap rv__controls">
    <div class="rv__buttons">
      <button type="button" data-rv-prev aria-label="Previous review">
        <span aria-hidden="true">←</span>
      </button>
      <button type="button" data-rv-next aria-label="Next review">
        <span aria-hidden="true">→</span>
      </button>
      <button
        type="button"
        class="rv__play"
        data-rv-play
        aria-label="Pause automatic scrolling"
        aria-pressed="false"
      >
        <span class="rv__play-icon" aria-hidden="true"></span>
      </button>
    </div>

  </div>
</section>

<script>
  const track = document.querySelector<HTMLElement>("[data-rv-track]");

  if (track) {
    const cards = [...track.querySelectorAll<HTMLElement>(".gcard")];
    const prev = document.querySelector<HTMLButtonElement>("[data-rv-prev]");
    const next = document.querySelector<HTMLButtonElement>("[data-rv-next]");
    const play = document.querySelector<HTMLButtonElement>("[data-rv-play]");
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

    // the set is rendered twice; one set is what we wrap by
    const perSet = cards.length / 2;
    const SPEED = 40; // px per second — slow enough to read while moving

    /* ---- clamp long reviews, with a per-card expander ---------------- */
    for (const card of cards) {
      const body = card.querySelector<HTMLElement>("[data-rv-body]");
      const more = card.querySelector<HTMLButtonElement>("[data-rv-more]");
      if (!body || !more) continue;
      if (body.scrollHeight > body.clientHeight + 4) {
        more.hidden = false;
        more.addEventListener("click", () => {
          const open = card.classList.toggle("is-open");
          more.textContent = open ? "Show less" : "Read more";
        });
      }
    }

    const stepOf = () => {
      const w = cards[0]?.getBoundingClientRect().width ?? track.clientWidth;
      const gap = parseFloat(getComputedStyle(track).columnGap || "0") || 0;
      return w + gap;
    };

    // exact width of one full set, measured from the DOM so it survives any
    // change to card width, gap or count
    const setWidth = () =>
      cards[perSet] && cards[0]
        ? cards[perSet].offsetLeft - cards[0].offsetLeft
        : stepOf() * perSet;

    /* ---- continuous motion -------------------------------------------
     * Driven by rAF over scrollLeft rather than a CSS transform, so the
     * track stays a real scroll container: still keyboard scrollable, still
     * drag/swipeable, and the scrollbar position stays truthful.
     *
     * Three separate reasons to hold still, tracked apart so that leaving
     * the card does not resume something the reader deliberately paused:
     *   wanted   — the play/pause control
     *   hovering — pointer or keyboard focus is inside the track
     *   inView   — the carousel is on screen at all
     */
    let wanted = !reduced.matches;
    let hovering = false;
    let inView = false;
    let raf = 0;
    let last = 0;
    // Our own sub-pixel position. scrollLeft rounds to whole pixels, so
    // writing a 0.67px increment each frame rounds up to 1px and the speed
    // becomes a function of refresh rate rather than time — twice as fast on
    // a 120Hz display. Keep the precise value here and let the DOM round.
    let x = 0;
    let written = -1;

    const moving = () => wanted && !hovering && inView;

    const frame = (t: number) => {
      if (!moving()) {
        raf = 0;
        return;
      }
      const dt = last ? Math.min((t - last) / 1000, 0.05) : 0;
      last = t;

      // if anything else moved the track (a drag, a keypress, a nudge),
      // adopt that position rather than fighting it
      if (written < 0 || Math.abs(track.scrollLeft - written) > 2) x = track.scrollLeft;

      x += SPEED * dt;
      const w = setWidth();
      // wrap before the duplicate set runs out, so the seam is never visible
      if (w > 0 && x >= w) x -= w;

      track.scrollLeft = x;
      written = track.scrollLeft;
      raf = requestAnimationFrame(frame);
    };

    const paint = () => {
      play?.classList.toggle("is-paused", !wanted);
      play?.setAttribute("aria-pressed", String(!wanted));
      play?.setAttribute(
        "aria-label",
        wanted ? "Pause the reviews" : "Play the reviews"
      );
    };

    const tick = () => {
      if (moving() && !raf) {
        last = 0;
        written = -1; // resync to wherever the track actually is
        raf = requestAnimationFrame(frame);
      } else if (!moving() && raf) {
        cancelAnimationFrame(raf);
        raf = 0;
      }
      paint();
    };

    /* ---- stop on hover, and on keyboard focus ------------------------ */
    track.addEventListener("pointerenter", () => {
      hovering = true;
      tick();
    });
    track.addEventListener("pointerleave", () => {
      hovering = false;
      tick();
    });
    track.addEventListener("focusin", () => {
      hovering = true;
      tick();
    });
    track.addEventListener("focusout", () => {
      hovering = false;
      tick();
    });

    /* ---- explicit controls ------------------------------------------- */
    play?.addEventListener("click", () => {
      // an explicit press always wins, including under reduced motion
      wanted = !wanted;
      tick();
    });

    const nudge = (dir: number) => {
      wanted = false; // taking manual control stops the drift
      tick();
      track.scrollBy({ left: dir * stepOf(), behavior: reduced.matches ? "auto" : "smooth" });
    };
    prev?.addEventListener("click", () => nudge(-1));
    next?.addEventListener("click", () => nudge(1));

    /* ---- only run while on screen ------------------------------------ */
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) inView = e.isIntersecting;
        tick();
      },
      { threshold: 0.2 }
    );
    io.observe(track);

    reduced.addEventListener?.("change", () => {
      if (reduced.matches) {
        wanted = false;
        tick();
      }
    });

    paint();
  }
</script>

<style>
  .rv {
    overflow: hidden;
  }

  .rv__head {
    display: grid;
    gap: 1.5rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .rv__head h2 {
    margin-top: 0.4em;
    max-width: 16ch;
  }

  .rv__intro {
    max-width: 44ch;
  }

  .rv__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    margin-top: 1.2rem;
    padding: 0.5em 0.95em;
    background: color-mix(in srgb, var(--bone) 9%, transparent);
    border: 1px solid color-mix(in srgb, var(--bone) 18%, transparent);
    border-radius: 999px;
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--drape-pale);
  }

  .glogo,
  .gcard__g {
    display: block;
    flex: 0 0 auto;
  }

  .glogo svg {
    width: 14px;
    height: 14px;
    display: block;
  }

  @media (min-width: 62rem) {
    .rv__head {
      grid-template-columns: 1.1fr 0.9fr;
      align-items: end;
      gap: 3rem;
    }
  }

  /* ---------------------------------------------- carousel plumbing */
  .rv__viewport {
    position: relative;
    /* Cards now travel right to the viewport edge, so soften both ends.
       This also keeps them from colliding hard with the page spine. */
    -webkit-mask-image: linear-gradient(
      to right, transparent 0, #000 7%, #000 93%, transparent 100%);
    mask-image: linear-gradient(
      to right, transparent 0, #000 7%, #000 93%, transparent 100%);
  }

  .rv__track {
    --track-pad: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter)));
    display: flex;
    /* equal heights: a ragged row of cards reads as broken in a carousel,
       even though Google's own list varies */
    align-items: stretch;
    column-gap: 1.25rem;
    padding-inline: var(--track-pad);
    scroll-padding-inline: var(--track-pad);
    padding-bottom: 1.5rem;
    overflow-x: auto;
    /* no scroll snapping: it fights a continuously moving track */
    scrollbar-width: none;
  }

  .rv__track::-webkit-scrollbar {
    display: none;
  }

  /* ---------------------------------------------- the Google card */
  .gcard {
    position: relative;
    flex: 0 0 min(24rem, 84vw);
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    background: #fff;
    color: #202124;
    border-radius: 10px;
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.18),
      0 8px 26px -12px rgba(0, 0, 0, 0.45);
    transition: transform 0.5s var(--ease-out), box-shadow 0.5s var(--ease-out);
  }

  .gcard:hover {
    transform: translateY(-3px);
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.2),
      0 16px 36px -14px rgba(0, 0, 0, 0.55);
  }

  .gcard__top {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.75rem;
  }

  .gcard__avatar {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--tint);
    color: #fff;
    font-family: var(--body);
    font-size: 1.05rem;
    font-weight: 500;
    line-height: 1;
  }

  .gcard__who {
    display: grid;
    gap: 0.12rem;
    min-width: 0;
  }

  .gcard__name {
    font-size: 0.95rem;
    font-weight: 500;
    color: #202124;
  }

  .gcard__meta {
    font-size: 0.78rem;
    color: #70757a;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .gcard__guide {
    color: #5f6368;
  }

  .gcard__g svg {
    width: 17px;
    height: 17px;
    display: block;
  }

  .gcard__rating {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.9rem;
  }

  .gcard__stars {
    display: inline-flex;
    gap: 1px;
  }

  .star {
    width: 15px;
    height: 15px;
    fill: #fbbc04;
    display: block;
  }

  .gcard__when {
    font-size: 0.78rem;
    color: #70757a;
  }

  .gcard__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .gcard__body {
    margin-top: 0.85rem;
    font-size: 0.9rem;
    line-height: 1.6;
    color: #3c4043;
    /* Google clamps long reviews; so do we, with a real expander */
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 8;
    line-clamp: 8;
    overflow: hidden;
  }

  .gcard.is-open .gcard__body {
    -webkit-line-clamp: unset;
    line-clamp: unset;
    overflow: visible;
  }

  .gcard__body p + p {
    margin-top: 0.7rem;
  }

  .gcard__more {
    align-self: start;
    margin-top: 0.7rem;
    padding: 0;
    background: none;
    border: 0;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 500;
    color: #1a73e8;
    cursor: pointer;
  }

  .gcard__more:hover {
    text-decoration: underline;
  }

  /* ---------------------------------------------- controls */
  .rv__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.2rem;
    margin-top: 1.6rem;
  }

  .rv__buttons {
    display: flex;
    gap: 0.6rem;
  }

  .rv__buttons button {
    width: 2.9rem;
    height: 2.9rem;
    display: grid;
    place-items: center;
    font-size: 1rem;
    color: var(--bone);
    background: transparent;
    border: 1px solid color-mix(in srgb, var(--bone) 28%, transparent);
    border-radius: 50%;
    cursor: pointer;
    transition: background-color 0.3s var(--ease), opacity 0.3s var(--ease),
      border-color 0.3s var(--ease);
  }

  .rv__buttons button:hover:not(:disabled) {
    background: color-mix(in srgb, var(--bone) 12%, transparent);
    border-color: var(--iodine-bright);
  }

  .rv__buttons button:disabled {
    opacity: 0.3;
    cursor: default;
  }

  /* pause / play glyph drawn in CSS so it can morph */
  .rv__play-icon {
    position: relative;
    display: block;
    width: 10px;
    height: 12px;
  }

  .rv__play-icon::before,
  .rv__play-icon::after {
    content: "";
    position: absolute;
    top: 0;
    width: 3px;
    height: 12px;
    background: currentColor;
    transition: all 0.3s var(--ease);
  }

  .rv__play-icon::before {
    left: 0;
  }
  .rv__play-icon::after {
    right: 0;
  }

  /* paused -> show a play triangle */
  .rv__play.is-paused .rv__play-icon::before {
    left: 1px;
    width: 0;
    height: 0;
    border-top: 6px solid transparent;
    border-bottom: 6px solid transparent;
    border-left: 10px solid currentColor;
    background: transparent;
  }

  .rv__play.is-paused .rv__play-icon::after {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .gcard,
    .rv__dots button {
      transition: none;
    }
  }
</style>
