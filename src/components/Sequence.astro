---
import SanityImage from "./SanityImage.astro";
import type { SanityImage as SanityImageField } from "../sanity/image";

/*
 * This one genuinely is a sequence, so it gets numbers. The image column
 * pins and cross-fades as each step comes into view. Content comes from the
 * home page's "Patient's day" section in the Studio.
 */
interface Props {
  eyebrow: string;
  heading: string;
  steps: { when: string; title: string; body: string; image?: SanityImageField }[];
}

const { eyebrow, heading, steps } = Astro.props;
---

<section class="band seq" id="experience">
  <div class="wrap seq__head" data-reveal>
    <p class="tag">{eyebrow}</p>
    <h2>{heading}</h2>
  </div>

  <div class="wrap seq__inner">
    <div class="seq__media" aria-hidden="true">
      <div class="seq__stack">
        {
          steps.map((s, i) => (
            <figure class:list={["seq__frame", { "is-active": i === 0 }]} data-seq-frame={i}>
              {s.image?.asset && (
                <SanityImage
                  image={s.image}
                  widths={[600, 900, 1300]}
                  sizes="(min-width: 62rem) 46vw, 90vw"
                  quality={80}
                />
              )}
            </figure>
          ))
        }
      </div>
    </div>

    <ol class="seq__steps">
      {
        steps.map((s, i) => (
          <li class="step" data-seq-step={i}>
            {s.image?.asset && (
              <figure class="step__inline">
                <SanityImage image={s.image} widths={[500, 800]} sizes="90vw" quality={78} />
              </figure>
            )}
            <p class="step__when">{s.when}</p>
            <h3 class="step__title">{s.title}</h3>
            <p class="step__body">{s.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<script>
  const steps = [...document.querySelectorAll<HTMLElement>("[data-seq-step]")];
  const frames = [...document.querySelectorAll<HTMLElement>("[data-seq-frame]")];

  if (steps.length && frames.length) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const idx = Number((entry.target as HTMLElement).dataset.seqStep);
          frames.forEach((f, i) => f.classList.toggle("is-active", i === idx));
          steps.forEach((s, i) => s.classList.toggle("is-active", i === idx));
        }
      },
      { rootMargin: "-48% 0px -48% 0px" }
    );
    steps.forEach((s) => io.observe(s));
  }
</script>

<style>
  .seq {
    background: var(--bone);
  }

  .seq__head {
    margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }

  .seq__head h2 {
    margin-top: 0.4em;
    max-width: 18ch;
  }

  .seq__inner {
    display: grid;
    gap: clamp(2rem, 5vw, 5rem);
  }

  /* --- pinned image column (desktop only) --- */
  .seq__media {
    display: none;
  }

  .seq__stack {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: 2px;
    overflow: hidden;
    background: var(--drape-wash);
  }

  .seq__frame {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    transform: scale(1.04);
    transition: opacity 0.9s var(--ease), transform 1.4s var(--ease-out);
  }

  .seq__frame.is-active {
    opacity: 1;
    transform: none;
  }

  .seq__frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* --- steps --- */
  .seq__steps {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: clamp(2.5rem, 5vw, 3rem);
  }

  .step {
    padding-top: 1.4rem;
    border-top: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
  }

  .step__inline {
    margin: 0 0 1.2rem;
    border-radius: 2px;
    overflow: hidden;
  }

  .step__inline :global(img) {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .step__when {
    font-family: var(--mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--iodine);
  }

  .step__title {
    margin-top: 0.5rem;
  }

  .step__body {
    margin-top: 0.7rem;
    color: var(--ink-soft);
    max-width: 42ch;
  }

  @media (min-width: 62rem) {
    .seq__inner {
      grid-template-columns: 1fr 1fr;
      gap: clamp(3rem, 7vw, 7rem);
      align-items: start;
    }

    /* Centre the pinned frame with a real sticky offset rather than a
       translate — a transform would lift it out of its own box and over the
       section heading above it. */
    .seq__media {
      --frame-h: min(72vh, 40rem);
      display: block;
      position: sticky;
      top: calc((100svh - var(--frame-h)) / 2);
    }

    .seq__stack {
      aspect-ratio: auto;
      height: var(--frame-h);
    }

    .step__inline {
      display: none;
    }

    /* each step holds the viewport long enough for its frame to register */
    .seq__steps {
      gap: 0;
    }

    .step {
      min-height: 78vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      border-top: 0;
      opacity: 0.35;
      transition: opacity 0.6s var(--ease);
    }

    .step.is-active {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .step {
      opacity: 1;
    }
    .seq__frame {
      transition: none;
    }
  }
</style>
