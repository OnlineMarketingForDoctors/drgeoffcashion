---
/**
 * The page's spine, borrowed from the instrument this practice actually
 * posts out to referring GPs. A Prader orchidometer is a graduated chain of
 * ellipsoids — you find the bead that matches and read off the volume. Here
 * the beads fill as you descend, so the scale doubles as a table of contents.
 *
 * Volumes are the real ones from the instrument (1–25 mL), not decoration.
 */

// Volumes are real orchidometer gradations: 1, 2, 3, 4, 6, 8, 12, 15, 25 mL.
const stops = [
  { id: "hero", label: "Dr Geoff Cashion", ml: 1 },
  { id: "volume", label: "By the numbers", ml: 2 },
  { id: "about", label: "Trained in the US", ml: 3 },
  { id: "why", label: "Why refer here", ml: 4 },
  { id: "experience", label: "Your patient's day", ml: 6 },
  { id: "watch", label: "How it's done", ml: 8 },
  { id: "research", label: "Research & teaching", ml: 12 },
  { id: "refer", label: "Refer a patient", ml: 25 },
];
---

<aside class="orch" aria-label="Page sections" data-orch>
  <ol class="orch__list">
    {
      stops.map((s, i) => (
        <li class="orch__item" style={`--i:${i}`}>
          <a href={`#${s.id}`} data-orch-link={s.id}>
            <span class="orch__bead" aria-hidden="true" />
            <span class="orch__label">
              <span class="orch__label-text">{s.label}</span>
              <span class="orch__label-ml">{s.ml} ml</span>
            </span>
            <span class="orch__sr">{s.label}</span>
          </a>
        </li>
      ))
    }
  </ol>
</aside>

<script>
  const spine = document.querySelector("[data-orch]");
  if (spine) {
    const links = [...spine.querySelectorAll<HTMLAnchorElement>("[data-orch-link]")];
    const targets = links
      .map((l) => document.getElementById(l.dataset.orchLink!))
      .filter((el): el is HTMLElement => el !== null);

    // Fill every bead down to the section currently in view.
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const idx = targets.indexOf(entry.target as HTMLElement);
          if (idx < 0) continue;
          // Flip the spine to the light palette over dark sections.
          const el = entry.target as HTMLElement;
          spine.classList.toggle(
            "orch--on-dark",
            el.classList.contains("band--dark") || el.classList.contains("band--drape")
          );
          links.forEach((l, i) => {
            l.classList.toggle("is-filled", i <= idx);
            l.classList.toggle("is-current", i === idx);
            if (i === idx) l.setAttribute("aria-current", "true");
            else l.removeAttribute("aria-current");
          });
        }
      },
      { rootMargin: "-45% 0px -45% 0px" }
    );

    targets.forEach((t) => io.observe(t));
    spine.classList.add("is-ready");
  }
</script>

<style>
  .orch {
    display: none;
    position: fixed;
    left: max(0.9rem, 1.4vw);
    top: 50%;
    transform: translateY(-50%);
    z-index: 40;
    opacity: 0;
    transition: opacity 0.8s var(--ease) 0.6s;
  }

  .orch.is-ready {
    opacity: 1;
  }

  .orch__list {
    display: grid;
    gap: 0.85rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .orch__item {
    display: flex;
  }

  .orch__item a {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.12rem;
    text-decoration: none;
  }

  /* Each bead is a touch larger than the one above it — the graduation is
     the whole point of the instrument. */
  .orch__bead {
    --size: calc(0.44rem + var(--i) * 0.075rem);
    display: block;
    width: var(--size);
    height: calc(var(--size) * 1.28);
    border-radius: 50%;
    background: transparent;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--drape) 55%, transparent);
    transition: background-color 0.55s var(--ease), box-shadow 0.55s var(--ease),
      transform 0.55s var(--ease-out);
  }

  .orch__item a.is-filled .orch__bead {
    background: var(--iodine);
    box-shadow: inset 0 0 0 1px var(--iodine);
  }

  .orch__item a.is-current .orch__bead {
    transform: scale(1.35);
  }

  .orch__label {
    display: grid;
    gap: 0.1em;
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 0.4s var(--ease), transform 0.4s var(--ease-out);
    pointer-events: none;
    white-space: nowrap;
  }

  /* Labels appear on intent only — showing the current one permanently
     overprints the page content on narrower desktops. */
  .orch__item a:hover .orch__label,
  .orch__item a:focus-visible .orch__label {
    opacity: 1;
    transform: none;
  }

  .orch__label-text {
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .orch__label-ml {
    font-family: var(--mono);
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    color: color-mix(in srgb, var(--ink) 45%, transparent);
  }

  .orch__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  /* Over the dark bands the spine flips to the light palette. */
  .orch--on-dark .orch__bead {
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--drape-pale) 60%, transparent);
  }

  .orch--on-dark .orch__item a.is-filled .orch__bead {
    background: var(--iodine-bright);
    box-shadow: inset 0 0 0 1px var(--iodine-bright);
  }

  .orch--on-dark .orch__label-text {
    color: var(--bone);
  }

  .orch--on-dark .orch__label-ml {
    color: color-mix(in srgb, var(--drape-pale) 75%, transparent);
  }

  /* Only once the viewport is wider than the content column plus room for a
     label does the spine have somewhere to live. */
  @media (min-width: 90rem) {
    .orch {
      display: block;
    }
  }
</style>
