---
import SanityImage from "./SanityImage.astro";
import type { SanityImage as SanityImageField } from "../sanity/image";
import JsonLd from "./JsonLd.astro";
import { absolute } from "../lib/schema";

interface Props {
  eyebrow: string;
  title: string;
  /** Optional ending of the title, set in the accent style. */
  titleEmphasis?: string;
  lede?: string;
  /** From Sanity; its hotspot sets where the subject sits in the frame. */
  image: SanityImageField;
  crumb: string;
}

const { eyebrow, title, titleEmphasis, lede, image, crumb } = Astro.props;

// Mirrors the visible breadcrumb: Home, then this page.
const breadcrumb = {
  "@type": "BreadcrumbList",
  "@id": `${absolute(Astro.url.pathname, Astro.site)}#breadcrumb`,
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: absolute("/", Astro.site) },
    { "@type": "ListItem", position: 2, name: crumb, item: absolute(Astro.url.pathname, Astro.site) },
  ],
};
---

<section class="phero" id="top">
  <div class="phero__media">
    <SanityImage image={image} widths={[900, 1400, 2000, 2600]} sizes="100vw" quality={80} eager />
  </div>
  <div class="phero__scrim"></div>

  <div class="wrap phero__inner">
    <JsonLd data={breadcrumb} />
    <nav class="phero__crumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{crumb}</span>
    </nav>

    <p class="tag tag--pale phero__eyebrow">{eyebrow}</p>
    <h1 class="phero__title">
      {title}
      {titleEmphasis && <em>{titleEmphasis}</em>}
    </h1>
    {lede && <p class="lede phero__lede">{lede}</p>}
  </div>
</section>

<style>
  .phero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: min(78svh, 44rem);
    background: var(--ink);
    color: var(--bone);
    overflow: hidden;
  }

  .phero__media {
    position: absolute;
    inset: 0;
  }

  .phero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: pheroIn 1.6s var(--ease-out) both;
  }

  @keyframes pheroIn {
    from {
      transform: scale(1.06);
      opacity: 0;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }

  .phero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, rgba(14, 31, 27, 0.92) 0%, rgba(14, 31, 27, 0.68) 42%, rgba(14, 31, 27, 0.15) 74%),
      linear-gradient(to top, rgba(14, 31, 27, 0.88) 0%, transparent 48%);
  }

  .phero__inner {
    position: relative;
    padding-top: clamp(7rem, 16vh, 10rem);
    padding-bottom: clamp(3.5rem, 7vh, 5rem);
  }

  /* Parked in the bottom-right corner of the banner rather than sitting
     above the title, where it was competing with the eyebrow for the same
     job. .phero__inner is the flex item pinned to the bottom of the banner,
     so its box bottom is the banner's bottom. */
  .phero__crumb {
    position: absolute;
    right: var(--gutter);
    bottom: clamp(1.1rem, 2.5vh, 1.75rem);
    display: flex;
    gap: 0.6em;
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--drape-pale) 85%, transparent);
    animation: riseIn 0.8s var(--ease-out) 0.2s both;
  }

  .phero__crumb a {
    text-decoration: none;
    transition: color 0.3s var(--ease);
  }

  .phero__crumb a:hover {
    color: var(--iodine-bright);
  }

  .phero__eyebrow {
    animation: riseIn 0.9s var(--ease-out) 0.3s both;
  }

  .phero__title {
    max-width: 17ch;
    margin-top: 0.45em;
    animation: riseIn 1s var(--ease-out) 0.42s both;
  }

  .phero__lede {
    max-width: 40ch;
    margin-top: 1.4rem;
    color: var(--drape-pale);
    animation: riseIn 1s var(--ease-out) 0.56s both;
  }

  @keyframes riseIn {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Same treatment as the homepage on a phone: the photograph goes
     full-bleed above the copy instead of being flattened under a scrim
     heavy enough to make the type readable over a face. */
  @media (max-width: 47.99rem) {
    .phero {
      display: flex;
      flex-direction: column;
      min-height: 0;
    }

    .phero__media {
      position: relative;
      inset: auto;
      height: min(46svh, 22rem);
      flex: 0 0 auto;
    }

    .phero__scrim {
      inset: 0 0 auto 0;
      height: min(46svh, 22rem);
      background: linear-gradient(
        to bottom,
        rgba(14, 31, 27, 0.7) 0%,
        rgba(14, 31, 27, 0.08) 36%,
        rgba(14, 31, 27, 0.5) 78%,
        var(--ink) 100%
      );
    }

    .phero__inner {
      padding-top: clamp(1.5rem, 3.5vh, 2.25rem);
      padding-bottom: clamp(3rem, 6vh, 4rem);
    }
  }
</style>
