---
import { SITE } from "../site.config";

const links = [
  { href: "#about", label: "About" },
  { href: "#watch", label: "The procedure" },
  { href: "#research", label: "Research" },
  { href: "#refer", label: "Contact" },
];
---

<header class="nav" data-nav>
  <div class="nav__inner">
    <a class="nav__mark" href="/">
      <span class="nav__mark-name">Geoff Cashion</span>
      <span class="nav__mark-role">No-scalpel vasectomy</span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <div class="nav__actions">
      <a class="nav__phone" href={SITE.phoneHref}>
        <span class="nav__phone-label">{SITE.phoneLabel}</span>
        <span class="nav__phone-digits">{SITE.phoneDigits}</span>
      </a>
      <a class="btn nav__cta" href="#refer">Refer a patient</a>
    </div>
  </div>
</header>

<script>
  // The bar earns its background only once you've left the hero.
  const nav = document.querySelector("[data-nav]");
  const onScroll = () => nav?.classList.toggle("is-stuck", window.scrollY > 40);
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });
</script>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    transition: background-color 0.5s var(--ease), backdrop-filter 0.5s var(--ease);
  }

  /* Over a bright hero the bar has nothing to sit on, so it brings its own
     shade until the solid background takes over. */
  .nav::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 190%;
    background: linear-gradient(to bottom, rgba(14, 31, 27, 0.62), transparent);
    pointer-events: none;
    transition: opacity 0.5s var(--ease);
  }

  .nav.is-stuck::before {
    opacity: 0;
  }

  .nav.is-stuck {
    background: color-mix(in srgb, var(--ink) 88%, transparent);
    backdrop-filter: blur(14px) saturate(1.3);
  }

  .nav__inner {
    position: relative;
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 3rem);
    width: 100%;
    max-width: var(--max);
    margin-inline: auto;
    padding: clamp(0.9rem, 1.6vw, 1.4rem) var(--gutter);
    color: var(--bone);
  }

  .nav__mark {
    display: grid;
    gap: 0.15em;
    text-decoration: none;
    margin-right: auto;
  }

  .nav__mark-name {
    font-family: var(--display);
    font-size: 1.15rem;
    font-weight: 600;
    font-variation-settings: "opsz" 24, "SOFT" 20, "WONK" 1;
    letter-spacing: -0.015em;
    line-height: 1;
  }

  .nav__mark-role {
    font-family: var(--mono);
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--drape-pale);
    line-height: 1;
  }

  .nav__links {
    display: none;
    gap: clamp(1rem, 2vw, 2.1rem);
    font-size: 0.9rem;
  }

  .nav__links a {
    position: relative;
    text-decoration: none;
    padding-block: 0.3em;
    opacity: 0.82;
    transition: opacity 0.3s var(--ease);
  }

  .nav__links a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: var(--iodine-bright);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s var(--ease-out);
  }

  .nav__links a:hover {
    opacity: 1;
  }

  .nav__links a:hover::after {
    transform: scaleX(1);
  }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 1.6vw, 1.6rem);
  }

  .nav__phone {
    display: none;
    text-align: right;
    text-decoration: none;
    line-height: 1.15;
  }

  .nav__phone-label {
    display: block;
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    color: color-mix(in srgb, var(--bone) 80%, transparent);
  }

  .nav__phone-digits {
    display: block;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .nav__cta {
    padding: 0.75em 1.35em;
    font-size: 0.85rem;
  }

  @media (min-width: 60rem) {
    .nav__links,
    .nav__phone {
      display: flex;
    }
    .nav__phone {
      display: block;
    }
  }
</style>
