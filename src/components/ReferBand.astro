---
import SanityImage from "./SanityImage.astro";
import { getSiteSettings } from "../sanity/queries";

interface Props {
  /** Interior pages carry an id so the spine and nav can target them. */
  id?: string;
}
const { id = "refer" } = Astro.props;
const SITE = await getSiteSettings();
---

<section class="band band--dark refer" id={id}>
  <div class="wrap refer__inner">
    <div class="refer__main">
      <p class="tag tag--pale" data-reveal>{SITE.referEyebrow}</p>
      <h2 data-reveal style="--delay:80ms">{SITE.referHeading}</h2>
      <p class="lede" data-reveal style="--delay:160ms">
        {SITE.referBody}
      </p>
      <p class="refer__reg" data-reveal style="--delay:180ms">
        Dr Geoffrey Cashion · AHPRA reg. {SITE.ahpra}
      </p>

      <div class="refer__actions" data-reveal style="--delay:240ms">
        <a class="btn" href={SITE.referButton.href}>
          {SITE.referButton.label}
          <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn btn--ghost btn--on-dark" href={SITE.phoneHref}>
          {SITE.phoneLabel}
        </a>
      </div>

    </div>

    <aside class="offer" data-reveal style="--delay:200ms">
      {
        SITE.offerImage?.asset && (
          <figure class="offer__figure">
            <SanityImage
              image={SITE.offerImage}
              widths={[420, 700, 1024]}
              sizes="(min-width: 62rem) 38vw, 90vw"
              quality={82}
            />
          </figure>
        )
      }
      <div class="offer__text">
        {SITE.offerEyebrow && <p class="tag tag--pale">{SITE.offerEyebrow}</p>}
        {SITE.offerHeading && <h3>{SITE.offerHeading}</h3>}
        {SITE.offerBody && <p>{SITE.offerBody}</p>}
        {
          SITE.offerLinkLabel && (
            <a class="offer__link" href={`mailto:${SITE.email}?subject=Orchidometer`}>
              {SITE.offerLinkLabel} <span aria-hidden="true">→</span>
            </a>
          )
        }
      </div>
    </aside>
  </div>
</section>

<style>
  .refer__inner {
    display: grid;
    gap: clamp(3rem, 6vw, 5rem);
    align-items: center;
  }

  .refer__main h2 {
    margin-top: 0.3em;
  }

  .refer__main .lede {
    margin-top: 1.3rem;
    max-width: 40ch;
  }

  .refer__reg {
    margin-top: 0.9rem;
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: color-mix(in srgb, var(--drape-pale) 80%, transparent);
  }

  .refer__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2.2rem;
  }


  /* the orchidometer offer — the page's signature, paid off */
  .offer {
    display: grid;
    gap: 1.6rem;
    padding: clamp(1.5rem, 3vw, 2.2rem);
    background: color-mix(in srgb, var(--drape-deep) 55%, transparent);
    border: 1px solid color-mix(in srgb, var(--drape-pale) 22%, transparent);
    border-radius: 3px;
  }

  .offer__figure {
    margin: 0;
    overflow: hidden;
    border-radius: 2px;
  }

  .offer__figure :global(img) {
    width: 100%;
    transition: transform 1.2s var(--ease-out);
  }

  .offer:hover .offer__figure :global(img) {
    transform: scale(1.04);
  }

  .offer__text h3 {
    margin-top: 0.45em;
  }

  .offer__text p {
    margin-top: 0.8rem;
    font-size: 0.95rem;
    color: var(--drape-pale);
    max-width: 38ch;
  }

  .offer__link {
    display: inline-flex;
    gap: 0.5em;
    margin-top: 1.2rem;
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--iodine-bright);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--iodine-bright) 45%, transparent);
    padding-bottom: 0.2em;
    transition: border-color 0.3s var(--ease);
  }

  .offer__link:hover {
    border-bottom-color: var(--iodine-bright);
  }

  @media (min-width: 62rem) {
    .refer__inner {
      grid-template-columns: 1.05fr 0.95fr;
    }
  }
</style>
