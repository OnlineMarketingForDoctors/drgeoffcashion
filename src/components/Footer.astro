---
import { getSiteSettings } from "../sanity/queries";

const SITE = await getSiteSettings();

const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="wrap foot__inner">
    <div class="foot__mark">
      <p class="foot__name">{SITE.brandName}</p>
      <p class="tag tag--pale">{SITE.footerTagline}</p>
      <p class="foot__ahpra">AHPRA reg. {SITE.ahpra}</p>
    </div>

    <nav class="foot__nav" aria-label="Footer">
      {SITE.footerLinks.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <a class="foot__phone" href={SITE.phoneHref}>
      {SITE.phoneCaption && <span class="tag tag--pale">{SITE.phoneCaption}</span>}
      <span class="foot__phone-digits">{SITE.phoneLabel}</span>
      <span class="foot__phone-alt">{SITE.phoneDigits}</span>
    </a>
  </div>

  <div class="wrap foot__base">
    <p>
      © {year} {SITE.copyrightHolder}. All rights reserved.
      <span aria-hidden="true">·</span>
      <a class="foot__credit" href="/sitemap/">Sitemap</a>
    </p>
    {
      SITE.credit && (
        <p>
          Powered by
          <a class="foot__credit" href={SITE.credit.href} target="_blank" rel="nofollow noopener noreferrer">
            {SITE.credit.label}
          </a>
        </p>
      )
    }
  </div>
</footer>

<style>
  .foot {
    background: var(--ink);
    color: var(--bone);
    padding-block: clamp(3.5rem, 7vw, 6rem) 2rem;
  }

  .foot__inner {
    display: grid;
    gap: 2.5rem;
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .foot__name {
    font-family: var(--display);
    font-size: clamp(1.8rem, 1.2rem + 2vw, 2.75rem);
    font-weight: 600;
    font-variation-settings: "opsz" 48, "SOFT" 20, "WONK" 1;
    letter-spacing: -0.02em;
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .foot__ahpra {
    margin-top: 0.7rem;
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    color: color-mix(in srgb, var(--bone) 55%, transparent);
  }

  .foot__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.75rem;
    font-size: 0.95rem;
  }

  .foot__nav a {
    text-decoration: none;
    opacity: 0.8;
    transition: opacity 0.3s var(--ease);
  }

  .foot__nav a:hover {
    opacity: 1;
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .foot__phone {
    display: grid;
    gap: 0.15rem;
    text-decoration: none;
  }

  .foot__phone-digits {
    font-family: var(--display);
    font-size: 1.5rem;
    font-variation-settings: "opsz" 30, "SOFT" 20, "WONK" 0;
  }

  .foot__phone-alt {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--drape-pale);
  }

  .foot__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-top: 2rem;
    /* clears the fixed back-to-top button, which otherwise sits on top of
       the credit line at several widths */
    padding-bottom: 3.5rem;
    border-top: 1px solid color-mix(in srgb, var(--bone) 15%, transparent);
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: color-mix(in srgb, var(--bone) 62%, transparent);
  }

  .foot__base p {
    margin: 0;
  }

  .foot__credit {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--bone) 28%, transparent);
    padding-bottom: 0.1em;
    transition: color 0.3s var(--ease), border-color 0.3s var(--ease);
  }

  .foot__credit:hover {
    color: var(--bone);
    border-bottom-color: var(--iodine-bright);
  }

  @media (min-width: 48rem) {
    .foot__inner {
      grid-template-columns: 1fr auto auto;
      align-items: start;
      gap: 3rem;
    }
    .foot__nav {
      flex-direction: column;
      gap: 0.6rem;
    }
  }
</style>
