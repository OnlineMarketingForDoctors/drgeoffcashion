---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import ReferBand from "../components/ReferBand.astro";
import RichText from "../components/RichText.astro";
import SanityImage from "../components/SanityImage.astro";
import { getPage, getSiteSettings, withSlash } from "../sanity/queries";

const SITE = await getSiteSettings();
const page = await getPage("about");
const { lead, scale, rural, access, quals, teaching, quote } = page;
---

<Base title={page.metaTitle} description={page.metaDescription}>
  <Nav />

  <main id="main" tabindex="-1">
    <PageHero
      eyebrow={page.eyebrow}
      title={page.heading}
      titleEmphasis={page.headingEmphasis}
      lede={page.lede}
      image={page.heroImage}
      crumb={page.breadcrumb ?? page.eyebrow}
    />

    <!-- ============================================ LEAD -->
    <section class="band lead" id="who">
      <div class="wrap lead__inner">
        <div class="lead__statement" data-reveal>
          <RichText value={lead.statement} />
        </div>

        <div class="lead__cols">
          {
            lead.columns.map((text: string, i: number) => (
              <div class="lead__col" data-reveal style={`--delay:${100 + i * 100}ms`}>
                <p>{text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============================================ SCALE -->
    <section class="band band--drape scale" id="scale">
      <div class="wrap">
        <p class="tag tag--pale" data-reveal>{scale.eyebrow}</p>
        <h2 data-reveal style="--delay:80ms">{scale.heading}</h2>

        <dl class="scale__grid">
          {
            scale.stats.map((s: { figure: string; label: string }, i: number) => (
              <div class="scale__item" data-reveal style={`--delay:${140 + i * 80}ms`}>
                <dt class="scale__label">{s.label}</dt>
                <dd class="scale__figure">{s.figure}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <!-- ============================================ ROCKHAMPTON — full bleed -->
    <section class="bleed" id="rural">
      <div class="bleed__media">
        <SanityImage image={rural.image} widths={[1200, 1800, 2600]} sizes="100vw" quality={78} />
      </div>
      <div class="bleed__scrim"></div>
      <div class="wrap bleed__inner">
        <p class="tag tag--pale" data-reveal>{rural.eyebrow}</p>
        <h2 data-reveal style="--delay:80ms">{rural.heading}</h2>
        <p class="lede" data-reveal style="--delay:160ms">{rural.lede}</p>
      </div>
    </section>

    <!-- ============================================ REGIONAL -->
    <section class="band split" id="access">
      <div class="wrap split__inner">
        <div class="split__text">
          <p class="tag" data-reveal>{access.eyebrow}</p>
          <h2 data-reveal style="--delay:80ms">{access.heading}</h2>
          <div class="split__prose" data-reveal style="--delay:160ms">
            <RichText value={access.body} />
          </div>
        </div>
        <figure class="split__figure" data-reveal style="--delay:120ms">
          <SanityImage
            image={access.image}
            widths={[600, 900, 1300]}
            sizes="(min-width: 60rem) 48vw, 90vw"
            quality={80}
          />
        </figure>
      </div>
    </section>

    <!-- ============================================ QUALIFICATIONS -->
    <section class="band quals" id="qualifications">
      <div class="wrap quals__inner">
        <div class="quals__head">
          <p class="tag" data-reveal>{quals.eyebrow}</p>
          <h2 data-reveal style="--delay:80ms">{quals.heading}</h2>
          <p class="lede" data-reveal style="--delay:160ms">{quals.lede}</p>
          <figure class="quals__figure" data-reveal style="--delay:240ms">
            <SanityImage
              image={quals.image}
              widths={[500, 800, 1100]}
              sizes="(min-width: 62rem) 38vw, 90vw"
              quality={78}
            />
          </figure>
        </div>

        <p class="quals__reg">{quals.registration} {SITE.ahpra}</p>

        <ol class="tl">
          {
            quals.items.map((q: { year: number; award: string; institution: string }, i: number) => (
              <li class="tl__item" data-reveal style={`--delay:${i * 90}ms`}>
                <span class="tl__year">{q.year}</span>
                <span class="tl__dot" aria-hidden="true" />
                <span class="tl__body">
                  <span class="tl__award">{q.award}</span>
                  <span class="tl__inst">{q.institution}</span>
                </span>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- ============================================ THOUGHT LEADERSHIP -->
    <section class="band band--dark teach" id="teaching">
      <div class="wrap teach__inner">
        <figure class="teach__figure" data-reveal>
          <SanityImage
            image={teaching.image}
            widths={[600, 1000, 1500]}
            sizes="(min-width: 62rem) 52vw, 90vw"
            quality={78}
          />
        </figure>
        <div class="teach__text">
          <p class="tag tag--pale" data-reveal>{teaching.eyebrow}</p>
          <h2 data-reveal style="--delay:80ms">{teaching.heading}</h2>
          <p class="lede" data-reveal style="--delay:160ms">{teaching.lede}</p>
          <a class="teach__link" href={withSlash(teaching.link.href)} data-reveal style="--delay:240ms">
            {teaching.link.label} <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ============================================ QUOTE -->
    <section class="band quote" id="quote">
      <div class="wrap quote__inner">
        <figure class="quote__figure" data-reveal>
          <SanityImage
            image={quote.image}
            widths={[400, 700, 1000]}
            sizes="(min-width: 60rem) 32vw, 70vw"
            quality={82}
          />
        </figure>
        <blockquote class="quote__body" data-reveal style="--delay:120ms">
          <p>{quote.quote}</p>
          <cite>
            {quote.cite}<br />
            AHPRA registration {SITE.ahpra}
          </cite>
        </blockquote>
      </div>
    </section>

    <ReferBand />
  </main>

  <Footer />
</Base>

<style>
  /* ---------------------------------------------------- LEAD */
  .lead__statement {
    font-family: var(--display);
    font-size: clamp(1.5rem, 1.1rem + 1.9vw, 2.6rem);
    font-weight: 600;
    font-variation-settings: "opsz" 72, "SOFT" 25, "WONK" 1;
    line-height: 1.18;
    letter-spacing: -0.018em;
    max-width: 24ch;
    text-wrap: balance;
  }

  .lead__statement :global(em) {
    font-style: italic;
    color: var(--iodine);
  }

  .lead__cols {
    display: grid;
    gap: 1.6rem;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .lead__col p {
    color: var(--ink-soft);
    max-width: 46ch;
  }

  @media (min-width: 60rem) {
    .lead__cols {
      grid-template-columns: 1fr 1fr;
      gap: clamp(2rem, 5vw, 4rem);
      margin-left: auto;
      width: min(100%, 62rem);
    }
  }

  /* ---------------------------------------------------- SCALE */
  .scale h2 {
    margin-top: 0.4em;
    max-width: 14ch;
  }

  .scale__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem 1.5rem;
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
  }

  .scale__item {
    border-top: 1px solid color-mix(in srgb, var(--bone) 24%, transparent);
    padding-top: 1rem;
  }

  .scale__label {
    font-family: var(--mono);
    font-size: 0.64rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--drape-pale);
    order: 2;
  }

  .scale__figure {
    margin: 0 0 0.35rem;
    font-family: var(--display);
    font-size: clamp(2rem, 1.3rem + 2.4vw, 3.4rem);
    font-weight: 600;
    font-variation-settings: "opsz" 72, "SOFT" 20, "WONK" 0;
    line-height: 1;
    letter-spacing: -0.025em;
  }

  .scale__item {
    display: flex;
    flex-direction: column;
  }

  @media (min-width: 55rem) {
    .scale__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* ---------------------------------------------------- FULL BLEED */
  .bleed {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: min(85svh, 46rem);
    background: var(--ink);
    color: var(--bone);
    overflow: hidden;
  }

  .bleed__media {
    position: absolute;
    inset: 0;
  }

  .bleed__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* The sky in this frame is bright where the copy sits, so the scrim needs
     a horizontal pass as well as the vertical one. */
  .bleed__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, rgba(14, 31, 27, 0.88) 0%, rgba(14, 31, 27, 0.6) 45%, rgba(14, 31, 27, 0.1) 80%),
      linear-gradient(to top, rgba(14, 31, 27, 0.9) 4%, rgba(14, 31, 27, 0.3) 55%, rgba(14, 31, 27, 0.45) 100%);
  }

  .bleed__inner {
    position: relative;
    padding-block: clamp(3rem, 8vh, 6rem);
  }

  .bleed h2 {
    margin-top: 0.4em;
    max-width: 15ch;
  }

  .bleed .lede {
    margin-top: 1.3rem;
    max-width: 46ch;
    color: var(--drape-pale);
  }

  /* ---------------------------------------------------- SPLIT */
  .split__inner {
    display: grid;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
  }

  .split__text h2 {
    margin-top: 0.4em;
    max-width: 17ch;
  }

  .split__prose {
    display: grid;
    gap: 1.1rem;
    margin-top: 1.5rem;
    max-width: 46ch;
    color: var(--ink-soft);
  }

  .split__figure {
    margin: 0;
    border-radius: 2px;
    overflow: hidden;
  }

  .split__figure :global(img) {
    width: 100%;
  }

  @media (min-width: 60rem) {
    .split__inner {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* ---------------------------------------------------- TIMELINE */
  .quals {
    background: var(--bone-pure);
  }

  .quals__inner {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: start;
  }

  .quals__head h2 {
    margin-top: 0.4em;
    max-width: 12ch;
  }

  .quals__head .lede {
    margin-top: 1.2rem;
    max-width: 38ch;
  }

  .quals__figure {
    margin: 2rem 0 0;
    border-radius: 2px;
    overflow: hidden;
  }

  .quals__figure :global(img) {
    width: 100%;
  }

  .quals__reg {
    padding-bottom: 1.4rem;
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--drape);
  }

  .tl {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }

  /* the spine the dots sit on */
  .tl::before {
    content: "";
    position: absolute;
    left: 4.6rem;
    top: 0.6rem;
    bottom: 0.6rem;
    width: 1px;
    background: color-mix(in srgb, var(--ink) 16%, transparent);
  }

  .tl__item {
    display: grid;
    grid-template-columns: 3.6rem 2rem 1fr;
    align-items: start;
    gap: 0 0;
    padding: 1.5rem 0;
  }

  .tl__year {
    font-family: var(--mono);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--drape);
    padding-top: 0.25em;
  }

  .tl__dot {
    position: relative;
    width: 100%;
    height: 1.4em;
  }

  .tl__dot::after {
    content: "";
    position: absolute;
    left: 1rem;
    top: 0.35em;
    width: 9px;
    height: 11px;
    border-radius: 50%;
    background: var(--iodine);
    transform: translateX(-50%);
  }

  .tl__body {
    display: grid;
    gap: 0.2rem;
  }

  .tl__award {
    font-family: var(--display);
    font-size: clamp(1.1rem, 1rem + 0.5vw, 1.35rem);
    font-weight: 600;
    font-variation-settings: "opsz" 30, "SOFT" 20, "WONK" 0;
    line-height: 1.25;
  }

  .tl__inst {
    font-size: 0.94rem;
    color: var(--ink-soft);
  }

  @media (min-width: 62rem) {
    .quals__inner {
      grid-template-columns: 0.85fr 1.15fr;
    }
  }

  /* ---------------------------------------------------- TEACHING */
  .teach__inner {
    display: grid;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
  }

  .teach__figure {
    margin: 0;
    border-radius: 2px;
    overflow: hidden;
  }

  .teach__figure :global(img) {
    width: 100%;
  }

  .teach__text h2 {
    margin-top: 0.4em;
    max-width: 15ch;
  }

  .teach__text .lede {
    margin-top: 1.3rem;
    max-width: 42ch;
  }

  .teach__link {
    display: inline-flex;
    gap: 0.5em;
    margin-top: 1.6rem;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--iodine-bright);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--iodine-bright) 45%, transparent);
    padding-bottom: 0.2em;
    transition: border-color 0.3s var(--ease);
  }

  .teach__link:hover {
    border-bottom-color: var(--iodine-bright);
  }

  @media (min-width: 60rem) {
    .teach__inner {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }

  /* ---------------------------------------------------- QUOTE */
  .quote__inner {
    display: grid;
    gap: clamp(1.8rem, 4vw, 3.5rem);
    align-items: center;
  }

  .quote__figure {
    margin: 0;
    border-radius: 2px;
    overflow: hidden;
    max-width: 20rem;
  }

  .quote__figure :global(img) {
    width: 100%;
  }

  .quote__body {
    margin: 0;
    padding-left: clamp(1rem, 2vw, 1.8rem);
    border-left: 2px solid var(--iodine);
  }

  .quote__body p {
    font-family: var(--display);
    font-size: clamp(1.35rem, 1.05rem + 1.4vw, 2.15rem);
    font-variation-settings: "opsz" 60, "SOFT" 30, "WONK" 1;
    line-height: 1.22;
    letter-spacing: -0.018em;
    max-width: 22ch;
  }

  .quote__body cite {
    display: block;
    margin-top: 1.1rem;
    font-family: var(--mono);
    font-size: 0.68rem;
    font-style: normal;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--drape);
  }

  @media (min-width: 60rem) {
    .quote__inner {
      grid-template-columns: auto 1fr;
    }
  }
</style>
