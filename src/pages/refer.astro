---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import { getPage, getSiteSettings } from "../sanity/queries";

import referralImg from "../assets/generated/referral-desk.webp";

const SITE = await getSiteSettings();
const page = await getPage("refer");
---

<Base title={page.metaTitle} description={page.metaDescription}>
  <Nav />

  <main id="main" tabindex="-1">
    <PageHero
      eyebrow={page.eyebrow}
      title={page.heading}
      titleEmphasis={page.headingEmphasis}
      lede={page.lede}
      image={referralImg}
      imageAlt="A referral letter and fountain pen on a doctor's desk"
      focus="60% center"
      crumb={page.breadcrumb ?? page.eyebrow}
    />

    <section class="band rf" id="form">
      <div class="wrap rf__inner">
        <!-- ---------------------------------------------- aside -->
        <aside class="rf__aside">
          <p class="tag" data-reveal>The referral</p>
          <h2 data-reveal style="--delay:80ms">Refer a patient</h2>
          <p class="rf__note" data-reveal style="--delay:160ms">
            We need enough to contact your patient and enough to send the
            outcome back to you. Nothing else is required at this stage —
            anything clinical can follow in a letter.
          </p>

          <div class="rf__alt" data-reveal style="--delay:240ms">
            <p class="rf__alt-label">Rather not use a form?</p>
            <a class="rf__alt-link" href={SITE.phoneHref}>
              {SITE.phoneLabel}
              <span class="rf__alt-sub">{SITE.phoneDigits}</span>
            </a>
            <a class="rf__alt-link rf__alt-link--sm" href={`mailto:${SITE.email}`}>
              {SITE.email}
            </a>
          </div>
        </aside>

        <!-- ---------------------------------------------- form -->
        {/* Wufoo embed, as supplied by Vasectomy Australia. is:inline keeps
            Astro from bundling the script; the loader inserts form.js and
            renders the form into the div. */}
        <div class="rf__form">
          <div id="wufoo-z1funy0c0agqy7q"> Fill out my <a href="https://vasectomyaustralia.wufoo.com/forms/z1funy0c0agqy7q">online form</a>. </div><script type="text/javascript" is:inline> var z1funy0c0agqy7q; (function(d, t) { var s = d.createElement(t), options = { 'userName':'vasectomyaustralia', 'formHash':'z1funy0c0agqy7q', 'autoResize':true, 'height':'627', 'async':true, 'host':'wufoo.com', 'header':'show', 'ssl':true }; s.src = ('https:' == d.location.protocol ?'https://':'http://') + 'secure.wufoo.com/scripts/embed/form.js'; s.onload = s.onreadystatechange = function() { var rs = this.readyState; if (rs) if (rs != 'complete') if (rs != 'loaded') return; try { z1funy0c0agqy7q = new WufooForm(); z1funy0c0agqy7q.initialize(options); z1funy0c0agqy7q.display(); } catch (e) { } }; var scr = d.getElementsByTagName(t)[0], par = scr.parentNode; par.insertBefore(s, scr); })(document, 'script'); </script>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  .rf {
    background: var(--bone-pure);
  }

  .rf__inner {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: start;
  }

  /* ---------------------------------------------------- aside */
  .rf__aside h2 {
    margin-top: 0.4em;
    max-width: 14ch;
  }

  .rf__note {
    margin-top: 1.2rem;
    color: var(--ink-soft);
    max-width: 36ch;
  }

  .rf__alt {
    margin-top: 2.2rem;
    padding-top: 1.6rem;
    border-top: 1px solid color-mix(in srgb, var(--ink) 13%, transparent);
  }

  .rf__alt-label {
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--drape);
  }

  .rf__alt-link {
    display: block;
    margin-top: 0.9rem;
    font-family: var(--display);
    font-size: 1.45rem;
    font-weight: 600;
    font-variation-settings: "opsz" 30, "SOFT" 20, "WONK" 0;
    line-height: 1.1;
    letter-spacing: -0.015em;
    text-decoration: none;
    transition: color 0.3s var(--ease);
  }

  .rf__alt-link:hover {
    color: var(--iodine);
  }

  .rf__alt-link--sm {
    margin-top: 0.7rem;
    font-family: var(--body);
    font-size: 0.95rem;
    font-weight: 400;
    color: var(--ink-soft);
    overflow-wrap: anywhere;
  }

  .rf__alt-sub {
    display: block;
    margin-top: 0.15rem;
    font-family: var(--mono);
    font-size: 0.74rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
  }

  /* ---------------------------------------------------- form */
  /* Wufoo sizes its own iframe; this only stops it overflowing the grid */
  .rf__form {
    min-width: 0;
  }

  @media (min-width: 62rem) {
    .rf__inner {
      grid-template-columns: 0.72fr 1.28fr;
      gap: clamp(3rem, 6vw, 5.5rem);
    }

    .rf__aside {
      position: sticky;
      top: 7.5rem;
    }
  }
</style>
