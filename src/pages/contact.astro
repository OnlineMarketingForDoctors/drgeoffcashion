---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import ReferBand from "../components/ReferBand.astro";
import { SITE } from "../site.config";
import { getStates } from "../sanity/queries";

import receptionImg from "../assets/generated/reception.webp";

const totalClinics = (await getStates()).reduce((n, s) => n + s.clinics.length, 0);
---

<Base
  title="Contact Dr Geoff Cashion — questions about a patient"
  description="Contact Dr Geoff Cashion's rooms about a patient referral for no-scalpel vasectomy. Phone 1800 SNIPME, email, or send a question directly."
>
  <Nav />

  <main id="main" tabindex="-1">
    <PageHero
      eyebrow="Contact"
      title="Ask about a patient."
      lede="Questions about suitability, timing or a specific case go straight to the rooms. Dr Cashion answers clinical questions himself."
      image={receptionImg}
      imageAlt="An empty medical practice reception area in morning light"
      focus="60% center"
      crumb="Contact"
    />

    <!-- ============================================ DIRECT -->
    <section class="band direct" id="direct">
      <div class="wrap direct__inner">
        <div class="direct__head">
          <p class="tag" data-reveal>Direct</p>
          <h2 data-reveal style="--delay:80ms">Three ways through.</h2>
          <p class="lede" data-reveal style="--delay:160ms">
            For anything clinical, the phone is fastest. For anything with a
            document attached, use email.
          </p>
        </div>

        <ul class="chan">
          <li class="chan__item" data-reveal style="--delay:120ms">
            <span class="chan__label">Phone</span>
            <a class="chan__value" href={SITE.phoneHref}>{SITE.phoneLabel}</a>
            <span class="chan__sub">{SITE.phoneDigits}</span>
          </li>
          <li class="chan__item" data-reveal style="--delay:200ms">
            <span class="chan__label">Email</span>
            <a class="chan__value chan__value--sm" href={`mailto:${SITE.email}`}>
              {SITE.email}
            </a>
            <span class="chan__sub">Referrals and patient questions</span>
          </li>
          <li class="chan__item" data-reveal style="--delay:280ms">
            <span class="chan__label">Social</span>
            <a
              class="chan__value chan__value--sm"
              href={SITE.facebook}
              target="_blank"
              rel="noopener noreferrer"
            >
              facebook.com/vasectomyaustralia
            </a>
            <span class="chan__sub">Vasectomy Australia</span>
          </li>
        </ul>
      </div>
    </section>

    <!-- ============================================ FORM -->
    <section class="band band--dark cform" id="ask">
      <div class="wrap cform__inner">
        <div class="cform__text">
          <p class="tag tag--pale" data-reveal>Ask a question</p>
          <h2 data-reveal style="--delay:80ms">
            Have a question about a patient?
          </h2>
          <p class="lede" data-reveal style="--delay:160ms">
            Fill this out and Dr Cashion will contact you as soon as possible.
            Please keep patient identifiers out of the message — a description
            of the clinical question is enough to get a useful answer.
          </p>
          <p class="cform__aside" data-reveal style="--delay:240ms">
            Not a GP? Patients book directly through <a
              class="cform__aside-link"
              href={SITE.parentSite}
              target="_blank"
              rel="noopener">Vasectomy Australia</a> rather than through these
            rooms.
          </p>
        </div>

        <form class="cform__form" data-cform novalidate>
          <div class="field">
            <label for="cf-name">Your name</label>
            <input id="cf-name" name="name" type="text" autocomplete="name" required />
          </div>

          <div class="field">
            <label for="cf-practice">Practice</label>
            <input id="cf-practice" name="practice" type="text" autocomplete="organization" />
          </div>

          <div class="field">
            <label for="cf-email">Email</label>
            <input id="cf-email" name="email" type="email" autocomplete="email" required />
          </div>

          <div class="field">
            <label for="cf-phone">Phone <span class="field__opt">optional</span></label>
            <input id="cf-phone" name="phone" type="tel" autocomplete="tel" />
          </div>

          <div class="field field--wide">
            <label for="cf-message">Your question</label>
            <textarea id="cf-message" name="message" rows="5" required></textarea>
          </div>

          <div class="cform__actions">
            <button class="btn" type="submit">
              Send question
              <span class="btn__arrow" aria-hidden="true">→</span>
            </button>
            <p class="cform__status" data-cform-status role="status" aria-live="polite"></p>
          </div>
        </form>
      </div>
    </section>

    <!-- ============================================ WHERE -->
    <section class="band where" id="where">
      <div class="wrap where__inner">
        <div data-reveal>
          <p class="tag">Clinics</p>
          <h2>{totalClinics} clinics, six states.</h2>
          <p class="lede">
            If the question is simply "where is the nearest one", the full list
            is on the vasectomy page, filterable by state.
          </p>
          <a class="btn btn--ghost" href="/vasectomy#locations">
            Find a clinic
            <span class="btn__arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    <ReferBand />
  </main>

  <Footer />
</Base>

<script>
  /*
   * Interim submission path: a static site has nowhere to POST, so rather
   * than a form that silently fails, this opens the sender's own mail client
   * with the message prefilled. Swap for a real endpoint when one exists.
   */
  const form = document.querySelector<HTMLFormElement>("[data-cform]");
  const status = document.querySelector<HTMLElement>("[data-cform-status]");

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const get = (k: string) => String(data.get(k) ?? "").trim();

    const name = get("name");
    const email = get("email");
    const message = get("message");

    if (!name || !email || !message) {
      if (status) {
        status.textContent = "Add your name, email and question before sending.";
        status.dataset.state = "error";
      }
      return;
    }

    const body = [
      `Name: ${name}`,
      `Practice: ${get("practice") || "—"}`,
      `Email: ${email}`,
      `Phone: ${get("phone") || "—"}`,
      "",
      message,
    ].join("\n");

    const href =
      `mailto:info@vasectomyaustralia.com.au` +
      `?subject=${encodeURIComponent(`Question about a patient — ${name}`)}` +
      `&body=${encodeURIComponent(body)}`;

    window.location.href = href;

    if (status) {
      status.textContent = "Opening your email app with the message ready to send.";
      status.dataset.state = "ok";
    }
  });
</script>

<style>
  /* ---------------------------------------------------- DIRECT */
  .direct__inner {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }

  .direct__head h2 {
    margin-top: 0.4em;
    max-width: 12ch;
  }

  .direct__head .lede {
    margin-top: 1.2rem;
    max-width: 34ch;
  }

  .chan {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .chan__item {
    display: grid;
    gap: 0.3rem;
    padding: clamp(1.2rem, 2.5vw, 1.8rem) 0;
    border-top: 1px solid color-mix(in srgb, var(--ink) 13%, transparent);
  }

  .chan:last-child .chan__item:last-child,
  .chan__item:last-child {
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 13%, transparent);
  }

  .chan__label {
    font-family: var(--mono);
    font-size: 0.64rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--drape);
  }

  .chan__value {
    font-family: var(--display);
    font-size: clamp(1.5rem, 1.2rem + 1.4vw, 2.3rem);
    font-weight: 600;
    font-variation-settings: "opsz" 48, "SOFT" 20, "WONK" 0;
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-decoration: none;
    transition: color 0.3s var(--ease);
    overflow-wrap: anywhere;
  }

  .chan__value--sm {
    font-size: clamp(1.05rem, 0.95rem + 0.7vw, 1.4rem);
  }

  .chan__value:hover {
    color: var(--iodine);
  }

  .chan__sub {
    font-size: 0.88rem;
    color: var(--ink-soft);
  }

  @media (min-width: 60rem) {
    .direct__inner {
      grid-template-columns: 0.85fr 1.15fr;
      gap: clamp(3rem, 6vw, 5rem);
    }
  }

  /* ---------------------------------------------------- FORM */
  .cform__inner {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: start;
  }

  .cform__text h2 {
    margin-top: 0.4em;
    max-width: 15ch;
  }

  .cform__text .lede {
    margin-top: 1.3rem;
    max-width: 40ch;
  }

  .cform__aside-link {
    color: var(--bone);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--iodine-bright) 50%, transparent);
    padding-bottom: 0.1em;
    transition: border-color 0.3s var(--ease);
  }

  .cform__aside-link:hover {
    border-bottom-color: var(--iodine-bright);
  }

  .cform__aside {
    margin-top: 1.6rem;
    font-family: var(--mono);
    font-size: 0.74rem;
    line-height: 1.7;
    color: color-mix(in srgb, var(--drape-pale) 78%, transparent);
    max-width: 38ch;
  }

  .cform__form {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.2rem;
  }

  .field {
    display: grid;
    gap: 0.45rem;
  }

  .field label {
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--drape-pale);
  }

  .field__opt {
    opacity: 0.6;
    text-transform: none;
    letter-spacing: 0.06em;
  }

  .field input,
  .field textarea {
    width: 100%;
    padding: 0.85em 1em;
    background: color-mix(in srgb, var(--bone) 7%, transparent);
    border: 1px solid color-mix(in srgb, var(--bone) 22%, transparent);
    border-radius: 3px;
    font: inherit;
    font-size: 0.98rem;
    color: var(--bone);
    transition: border-color 0.3s var(--ease), background-color 0.3s var(--ease);
  }

  .field textarea {
    resize: vertical;
    min-height: 8rem;
  }

  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--iodine-bright);
    background: color-mix(in srgb, var(--bone) 11%, transparent);
  }

  .cform__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 0.4rem;
  }

  .cform__status {
    font-family: var(--mono);
    font-size: 0.74rem;
    color: var(--drape-pale);
  }

  .cform__status[data-state="error"] {
    color: var(--iodine-bright);
  }

  @media (min-width: 42rem) {
    .cform__form {
      grid-template-columns: 1fr 1fr;
    }
    .field--wide,
    .cform__actions {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 62rem) {
    .cform__inner {
      grid-template-columns: 0.9fr 1.1fr;
    }
  }

  /* ---------------------------------------------------- WHERE */
  .where {
    background: var(--bone-pure);
  }

  .where h2 {
    margin-top: 0.4em;
    max-width: 14ch;
  }

  .where .lede {
    margin-top: 1.2rem;
    max-width: 40ch;
  }

  .where .btn {
    margin-top: 2rem;
  }
</style>
