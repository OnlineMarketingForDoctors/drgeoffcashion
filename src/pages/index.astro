---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Orchidometer from "../components/Orchidometer.astro";
import Sequence from "../components/Sequence.astro";
import ReferBand from "../components/ReferBand.astro";
import RichText from "../components/RichText.astro";
import SanityImage from "../components/SanityImage.astro";
import { getPage, getSiteSettings, withSlash } from "../sanity/queries";
import { imageUrl, responsive } from "../sanity/image";

const SITE = await getSiteSettings();
const page = await getPage("home");
const { volume, about, why, sequence, watch, research } = page;

/*
 * Art direction rather than a crop: the wide frame cannot put him centred at
 * a phone's aspect ratio, so portrait screens get their own portrait shot.
 * Both come from the Studio (Hero image, Hero image on phones).
 */
const heroWide = responsive(page.heroImage, [900, 1400, 2000, 2600], 82);
const heroTall = responsive(page.heroImageMobile ?? page.heroImage, [420, 640, 900, 1240], 82);

/* A #section link stays as it is; a page path gets its trailing slash. */
const href = (h: string) => (h.startsWith("#") ? h : withSlash(h));
---

<Base title={page.metaTitle} description={page.metaDescription}>
  <Nav />
  <Orchidometer />

  <main id="main" tabindex="-1">
    <!-- ================================================== HERO -->
    <section class="hero" id="hero">
      <div class="hero__media">
        <picture>
          <source media="(max-width: 767.98px)" type="image/webp" srcset={heroTall.srcset} sizes="100vw" />
          <img
            src={heroWide.src}
            srcset={heroWide.srcset}
            sizes="100vw"
            width={heroWide.width}
            height={heroWide.height}
            alt={page.heroImage.alt}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      </div>

      <div class="hero__scrim"></div>

      <div class="wrap hero__inner">
        <p class="tag tag--pale hero__eyebrow">{page.eyebrow}</p>
        <h1 class="hero__title">
          {page.heading} {page.headingEmphasis && <em>{page.headingEmphasis}</em>}
        </h1>
        {page.lede && <p class="lede hero__lede">{page.lede}</p>}
        <div class="hero__actions">
          <a class="btn" href={href(page.heroPrimary.href)}>
            {page.heroPrimary.label}
            <span class="btn__arrow" aria-hidden="true">→</span>
          </a>
          <a class="btn btn--ghost btn--on-dark" href={href(page.heroSecondary.href)}>
            {page.heroSecondary.label}
          </a>
        </div>
      </div>

      <div class="hero__specs">
        <div class="wrap hero__specs-inner">
          {
            page.specs.map((s: { figure: string; label: string }) => (
              <div class="spec">
                <span class="spec__figure">{s.figure}</span>
                <span class="spec__label">{s.label}</span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ================================================== VOLUME -->
    <section class="band band--dark volume" id="volume">
      <div class="volume__bg" aria-hidden="true">
        <SanityImage image={volume.background} widths={[1200, 2000]} sizes="100vw" quality={70} />
      </div>

      <div class="wrap volume__inner">
        <div class="volume__head" data-reveal>
          <p class="tag tag--pale">{volume.eyebrow}</p>
          <h2>{volume.heading}</h2>
        </div>

        <div class="volume__body">
          <p class="lede" data-reveal style="--delay:120ms">{volume.lede}</p>
          <p data-reveal style="--delay:220ms">{volume.body}</p>
        </div>
      </div>
    </section>

    <!-- ================================================== ABOUT -->
    <section class="band about" id="about">
      <div class="wrap about__inner">
        <figure class="about__figure" data-reveal>
          <SanityImage
            image={about.image}
            widths={[600, 900, 1200]}
            sizes="(min-width: 60rem) 40vw, 90vw"
            quality={82}
          />
          <figcaption class="tag">{about.caption} {SITE.ahpra}</figcaption>
        </figure>

        <div class="about__text">
          <p class="tag" data-reveal>{about.eyebrow}</p>
          <h2 data-reveal style="--delay:80ms">{about.heading}</h2>

          <div class="about__prose" data-reveal style="--delay:160ms">
            <RichText value={about.body} />
          </div>

          <blockquote class="pull" data-reveal style="--delay:240ms">
            <p>{about.quote}</p>
            <cite>{about.quoteCite} {SITE.ahpra}</cite>
          </blockquote>
        </div>
      </div>
    </section>

    <!-- ================================================== WHY -->
    <section class="band why" id="why">
      <div class="wrap why__inner">
        <div class="why__sticky">
          <div class="why__head">
            <p class="tag">{why.eyebrow}</p>
            <h2>{why.heading}</h2>
          </div>
          <figure class="why__figure">
            <SanityImage
              image={why.image}
              widths={[600, 900, 1300]}
              sizes="(min-width: 60rem) 42vw, 90vw"
              quality={80}
            />
          </figure>
        </div>

        <ol class="why__list">
          {
            why.reasons.map((r: { lead: string; body: string }, i: number) => (
              <li class="reason" data-reveal style={`--delay:${i * 70}ms`}>
                <span class="reason__index">{String(i + 1).padStart(2, "0")}</span>
                <div class="reason__text">
                  <p class="reason__lead">{r.lead}</p>
                  <p class="reason__body">{r.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- ================================================== SEQUENCE -->
    <Sequence eyebrow={sequence.eyebrow} heading={sequence.heading} steps={sequence.steps} />

    <!-- ================================================== WATCH -->
    <section class="band band--drape watch" id="watch">
      <div class="wrap watch__inner">
        <div class="watch__head" data-reveal>
          <p class="tag tag--pale">{watch.eyebrow}</p>
          <h2>{watch.heading}</h2>
          <p class="lede">{watch.lede}</p>
        </div>

        <figure class="watch__player" data-reveal style="--delay:140ms">
          <video controls preload="none" playsinline poster={imageUrl(watch.poster, 1600, 80)}>
            <source src={watch.videoUrl} type="video/mp4" />
            Your browser does not support embedded video.
            <a href={watch.videoUrl} target="_blank" rel="nofollow noopener noreferrer">Download the explainer instead.</a>
          </video>
        </figure>
      </div>
    </section>

    <!-- ================================================== RESEARCH -->
    <section class="band research" id="research">
      <div class="wrap research__inner">
        <figure class="research__figure" data-reveal>
          <SanityImage
            image={research.image}
            widths={[700, 1100, 1600]}
            sizes="(min-width: 60rem) 52vw, 90vw"
            quality={78}
          />
        </figure>

        <div class="research__text">
          <p class="tag" data-reveal>{research.eyebrow}</p>
          <h2 data-reveal style="--delay:80ms">{research.heading}</h2>
          <p class="lede" data-reveal style="--delay:160ms">{research.lede}</p>
        </div>
      </div>
    </section>

    <ReferBand />

  </main>

  <Footer />
</Base>

<style>
  /* ============================================================ HERO */
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 100svh;
    background: var(--ink);
    color: var(--bone);
    overflow: hidden;
  }

  .hero__media {
    position: absolute;
    inset: 0;
  }

  .hero__media picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 72% center;
    animation: heroIn 1.8s var(--ease-out) both;
  }

  @keyframes heroIn {
    from {
      transform: scale(1.07);
      opacity: 0;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, rgba(14, 31, 27, 0.93) 0%, rgba(14, 31, 27, 0.72) 38%, rgba(14, 31, 27, 0.12) 68%),
      linear-gradient(to top, rgba(14, 31, 27, 0.9) 0%, transparent 42%);
  }

  .hero__inner {
    position: relative;
    padding-top: clamp(6rem, 11vh, 8rem);
    padding-bottom: clamp(1.75rem, 3vh, 2.5rem);
  }

  /* On a phone the portrait stops being a background and becomes a
     full-bleed image stacked above the copy — text over a face is a
     compromise that only earns its keep on a wide screen. */
  @media (max-width: 47.99rem) {
    .hero {
      display: flex;
      flex-direction: column;
      min-height: 0;
    }

    .hero__media {
      position: relative;
      inset: auto;
      /* close to the portrait source's own 4:5, so the composition survives
         with only a little crop */
      height: min(56svh, 28rem);
      flex: 0 0 auto;
    }

    /* He is centred horizontally in the source; bias the vertical crop
       upward so the headroom survives rather than being split evenly. */
    .hero__media :global(img) {
      object-position: center 25%;
    }

    /* Sits over the image only: shades the top so the fixed nav stays
       legible, then dissolves into the ink ground so the join to the copy
       below is invisible. */
    .hero__scrim {
      inset: 0 0 auto 0;
      height: min(56svh, 28rem);
      background: linear-gradient(
        to bottom,
        rgba(14, 31, 27, 0.72) 0%,
        rgba(14, 31, 27, 0.1) 34%,
        rgba(14, 31, 27, 0.55) 78%,
        var(--ink) 100%
      );
    }

    .hero__inner {
      padding-top: clamp(1.75rem, 4vh, 2.5rem);
      padding-bottom: clamp(2rem, 4vh, 2.75rem);
    }
  }

  .hero__eyebrow {
    animation: riseIn 0.9s var(--ease-out) 0.25s both;
  }

  .hero__title {
    max-width: 15ch;
    margin-top: 0.5em;
    animation: riseIn 1s var(--ease-out) 0.38s both;
  }

  .hero__title em {
    font-style: normal;
    color: var(--iodine-bright);
  }

  .hero__lede {
    max-width: 34ch;
    margin-top: 1.4rem;
    color: var(--drape-pale);
    animation: riseIn 1s var(--ease-out) 0.52s both;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: clamp(1.5rem, 3vh, 2.1rem);
    animation: riseIn 1s var(--ease-out) 0.66s both;
  }

  @keyframes riseIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* engraved spec strip along the bottom edge */
  .hero__specs {
    position: relative;
    border-top: 1px solid color-mix(in srgb, var(--bone) 20%, transparent);
    background: color-mix(in srgb, var(--ink) 55%, transparent);
    backdrop-filter: blur(8px);
    animation: riseIn 1s var(--ease-out) 0.85s both;
  }

  .hero__specs-inner {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }

  .spec {
    display: grid;
    gap: 0.25rem;
    padding: 1.05rem 0;
    border-top: 1px solid color-mix(in srgb, var(--bone) 12%, transparent);
  }

  .spec:nth-child(-n + 2) {
    border-top: 0;
  }

  .spec__figure {
    font-family: var(--display);
    font-size: clamp(1.2rem, 1rem + 0.7vw, 1.7rem);
    font-weight: 600;
    font-variation-settings: "opsz" 36, "SOFT" 20, "WONK" 0;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .spec__label {
    font-family: var(--mono);
    font-size: 0.63rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--drape-pale);
  }

  @media (min-width: 48rem) {
    .hero__specs-inner {
      grid-template-columns: repeat(5, 1fr);
      gap: clamp(1rem, 3vw, 3rem);
    }
    .spec {
      border-top: 0;
      padding: 1.3rem 0;
    }
  }

  /* ============================================================ VOLUME */
  .volume {
    position: relative;
    overflow: hidden;
  }

  .volume__bg {
    position: absolute;
    inset: 0;
    opacity: 0.22;
  }

  .volume__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .volume__inner {
    position: relative;
    display: grid;
    gap: clamp(2rem, 5vw, 4.5rem);
  }

  .volume__head h2 {
    margin-top: 0.4em;
    max-width: 16ch;
  }

  .volume__body {
    display: grid;
    gap: 1.4rem;
    align-content: start;
    max-width: 44ch;
  }

  .volume__body p:last-child {
    color: var(--drape-pale);
  }

  @media (min-width: 62rem) {
    .volume__inner {
      grid-template-columns: 1.05fr 1fr;
      align-items: start;
    }
  }

  /* ============================================================ ABOUT */
  .about__inner {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: center;
  }

  .about__figure {
    margin: 0;
  }

  .about__figure :global(img) {
    width: 100%;
    border-radius: 2px;
  }

  .about__figure figcaption {
    margin-top: 0.9rem;
  }

  .about__text h2 {
    margin-top: 0.4em;
    max-width: 18ch;
  }

  .about__prose {
    display: grid;
    gap: 1.1rem;
    margin-top: 1.6rem;
    max-width: 44ch;
    color: var(--ink-soft);
  }

  .pull {
    margin: 2.4rem 0 0;
    padding-left: 1.5rem;
    border-left: 2px solid var(--iodine);
  }

  .pull p {
    font-family: var(--display);
    font-size: clamp(1.3rem, 1.05rem + 1.1vw, 1.9rem);
    font-variation-settings: "opsz" 40, "SOFT" 30, "WONK" 1;
    line-height: 1.25;
    letter-spacing: -0.015em;
    max-width: 26ch;
  }

  .pull cite {
    display: block;
    margin-top: 0.9rem;
    font-family: var(--mono);
    font-size: 0.68rem;
    font-style: normal;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--drape);
  }

  @media (min-width: 60rem) {
    .about__inner {
      grid-template-columns: 0.85fr 1fr;
    }
  }

  /* ============================================================ WHY */
  .why {
    background: var(--bone-pure);
  }

  .why__inner {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: start;
  }

  .why__head h2 {
    margin-top: 0.4em;
    max-width: 14ch;
  }

  .why__figure {
    margin: 2rem 0 0;
  }

  .why__figure :global(img) {
    width: 100%;
    border-radius: 2px;
  }

  .why__list {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: none;
  }

  .reason {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.9rem 1.4rem;
    padding: clamp(1.4rem, 2.5vw, 2rem) 0;
    border-top: 1px solid color-mix(in srgb, var(--ink) 13%, transparent);
  }

  .reason:last-child {
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 13%, transparent);
  }

  .reason__index {
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--iodine);
    padding-top: 0.45em;
  }

  .reason__lead {
    font-family: var(--display);
    font-size: clamp(1.15rem, 1rem + 0.6vw, 1.45rem);
    font-weight: 600;
    font-variation-settings: "opsz" 32, "SOFT" 20, "WONK" 0;
    line-height: 1.25;
    letter-spacing: -0.012em;
  }

  .reason__body {
    margin-top: 0.5rem;
    font-size: 0.97rem;
    color: var(--ink-soft);
    max-width: 46ch;
  }

  @media (min-width: 62rem) {
    .why__inner {
      grid-template-columns: 0.9fr 1.1fr;
      gap: clamp(3rem, 6vw, 6rem);
    }
    .why__sticky {
      position: sticky;
      top: 7rem;
    }
  }

  /* ============================================================ WATCH */
  .watch__inner {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
  }

  .watch__head h2 {
    margin-top: 0.4em;
    max-width: 16ch;
  }

  .watch__head .lede {
    margin-top: 1.2rem;
    max-width: 48ch;
    color: var(--drape-pale);
  }

  .watch__player {
    margin: 0;
  }

  .watch__player video {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--ink);
    border-radius: 2px;
    box-shadow: 0 30px 70px -30px rgba(0, 0, 0, 0.6);
  }

  @media (min-width: 62rem) {
    .watch__inner {
      grid-template-columns: 0.72fr 1.28fr;
      align-items: center;
    }
  }

  /* ============================================================ RESEARCH */
  .research__inner {
    display: grid;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
  }

  .research__figure {
    margin: 0;
  }

  .research__figure :global(img) {
    width: 100%;
    border-radius: 2px;
  }

  .research__text h2 {
    margin-top: 0.4em;
    max-width: 15ch;
  }

  .research__text .lede {
    margin-top: 1.3rem;
    max-width: 42ch;
  }

  @media (min-width: 60rem) {
    .research__inner {
      grid-template-columns: 1.15fr 0.85fr;
    }
  }

</style>
