---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import ReferBand from "../components/ReferBand.astro";
import Occlusion from "../components/Occlusion.astro";
import LocationFinder from "../components/LocationFinder.astro";
import RichText from "../components/RichText.astro";
import SanityImage from "../components/SanityImage.astro";
import { getPage, getSiteSettings } from "../sanity/queries";
import JsonLd from "../components/JsonLd.astro";
import { absolute } from "../lib/schema";

const SITE = await getSiteSettings();
const page = await getPage("vasectomy");
const {
  facts,
  what,
  compare,
  technique,
  appointment,
  effectiveness,
  recovery,
  risks,
  unchanged,
  cost,
  permanence,
  locations,
} = page;

type Step = { at: string; title: string; body: string };
type Risk = { name: string; rate: string; body: string };
type Faq = { q: string; a: string };
type Bar = { label: string; value: string; amount: number };

/** Portable Text paragraphs as plain text, for structured data. */
const plain = (blocks: any[] = []) =>
  blocks.map((b) => (b.children ?? []).map((c: any) => c.text).join("")).join(" ");

/* Structured data, built from this page's content in Sanity, so the markup
   never claims more than a reader can see. */
const pageUrl = absolute(Astro.url.pathname, Astro.site);
const [arrival, ...procedureSteps] = appointment.steps as Step[];

const procedureSchema = {
  "@type": "MedicalProcedure",
  "@id": `${pageUrl}#procedure`,
  name: "No-scalpel vasectomy",
  alternateName: "Vasectomy",
  url: pageUrl,
  mainEntityOfPage: { "@id": `${pageUrl}#webpage` },
  description: plain(what.body),
  bodyLocation: "Vas deferens",
  preparation: arrival ? `${arrival.title}: ${arrival.body}` : undefined,
  howPerformed: procedureSteps.map((s) => `${s.title}: ${s.body}`).join(" "),
  followup: (recovery.items as { when: string; what: string }[]).map((r) => `${r.when}: ${r.what}`).join(" "),
  possibleComplication: (risks.items as Risk[]).map((r) => ({
    "@type": "MedicalCondition",
    name: r.name,
    description: `${r.rate}. ${r.body}`,
  })),
};

const faqSchema = {
  "@type": "FAQPage",
  "@id": `${pageUrl}#faq`,
  mainEntity: (unchanged.items as Faq[]).map((u) => ({
    "@type": "Question",
    name: u.q,
    acceptedAnswer: { "@type": "Answer", text: u.a },
  })),
};

// the cost bars are drawn to scale against the larger amount
const bars = cost.bars as Bar[];
const maxAmount = Math.max(...bars.map((b) => b.amount || 0), 1);
const barWidth = (b: Bar) => `${Math.max(2, Math.round((b.amount / maxAmount) * 1000) / 10)}%`;
---

<Base title={page.metaTitle} description={page.metaDescription}>
  <JsonLd data={procedureSchema} />
  <JsonLd data={faqSchema} />
  <Nav />

  <main id="main" tabindex="-1">
    <PageHero
      eyebrow={page.eyebrow}
      title={page.heading}
      titleEmphasis={page.headingEmphasis}
      lede={page.lede}
      image={page.heroImage}
      crumb={page.breadcrumb ?? page.eyebrow}
    />

    <div class="vas__reg">
      <p class="wrap">{facts.registration} {SITE.ahpra}</p>
    </div>

    <!-- ============================================ FACT STRIP -->
    <section class="factstrip" aria-label="Key facts">
      <div class="wrap factstrip__inner">
        {
          facts.items.map((f: { figure: string; label: string }) => (
            <div class="fact">
              <span class="fact__figure">{f.figure}</span>
              <span class="fact__label">{f.label}</span>
            </div>
          ))
        }
      </div>
    </section>

    <!-- ============================================ WHAT IT IS -->
    <section class="band whatis" id="what">
      <div class="wrap whatis__inner">
        <div class="whatis__text">
          <p class="tag" data-reveal>{what.eyebrow}</p>
          <h2 data-reveal style="--delay:80ms">{what.heading}</h2>
          <div class="prose" data-reveal style="--delay:160ms">
            <RichText value={what.body} />
          </div>
        </div>
        <figure class="whatis__figure" data-reveal style="--delay:120ms">
          <SanityImage
            image={what.image}
            widths={[600, 900, 1300]}
            sizes="(min-width: 62rem) 46vw, 90vw"
            quality={80}
          />
          {what.caption && <figcaption class="tag">{what.caption}</figcaption>}
        </figure>
      </div>
    </section>

    <!-- ============================================ COMPARISON -->
    <section class="band band--drape compare" id="compare">
      <div class="wrap">
        <div class="compare__head" data-reveal>
          <p class="tag tag--pale">{compare.eyebrow}</p>
          <h2>{compare.heading}</h2>
        </div>

        <div class="cmp">
          <div class="cmp__col cmp__col--old" data-reveal style="--delay:100ms">
            <p class="cmp__label">{compare.oldLabel}</p>
            <ul class="cmp__list">
              {compare.oldItems.map((item: string) => <li>{item}</li>)}
            </ul>
          </div>
          <div class="cmp__col cmp__col--new" data-reveal style="--delay:200ms">
            <p class="cmp__label">{compare.newLabel}</p>
            <ul class="cmp__list">
              {compare.newItems.map((item: string) => <li>{item}</li>)}
            </ul>
          </div>
        </div>
        <p class="cmp__foot" data-reveal style="--delay:280ms">{compare.footnote}</p>
      </div>
    </section>

    <!-- ============================================ OCCLUSION DIAGRAM -->
    <section class="band occwrap" id="technique">
      <div class="wrap">
        <div class="occwrap__head" data-reveal>
          <p class="tag">{technique.eyebrow}</p>
          <h2>{technique.heading}</h2>
          <p class="lede">{technique.lede}</p>
        </div>
        <Occlusion steps={technique.steps} />
      </div>
    </section>

    <!-- ============================================ APPOINTMENT TIMELINE -->
    <section class="band band--dark appt" id="appointment">
      <div class="wrap appt__head">
        <div data-reveal>
          <p class="tag tag--pale">{appointment.eyebrow}</p>
          <h2>{appointment.heading}</h2>
        </div>
        <p class="lede appt__intro" data-reveal style="--delay:120ms">{appointment.intro}</p>
      </div>

      <div class="appt__track" data-appt tabindex="0" role="region" aria-label="The appointment step by step, scrollable">
        {
          (appointment.steps as Step[]).map((s, i) => (
            <article class="appt__card">
              <span class="appt__at">{s.at}</span>
              <span class="appt__rule" aria-hidden="true" />
              <h3 class="appt__title">{s.title}</h3>
              <p class="appt__body">{s.body}</p>
              <span class="appt__n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            </article>
          ))
        }
      </div>

      <div class="wrap appt__controls">
        <button type="button" data-appt-prev aria-label="Previous step">
          <span aria-hidden="true">←</span>
        </button>
        <button type="button" data-appt-next aria-label="Next step">
          <span aria-hidden="true">→</span>
        </button>
      </div>
    </section>

    <!-- ============================================ EFFECTIVENESS -->
    <section class="band effect" id="effectiveness">
      <div class="wrap effect__inner">
        <figure class="effect__figure" data-reveal>
          <SanityImage
            image={effectiveness.image}
            widths={[600, 900, 1300]}
            sizes="(min-width: 62rem) 46vw, 90vw"
            quality={80}
          />
        </figure>
        <div class="effect__text">
          <p class="tag" data-reveal>{effectiveness.eyebrow}</p>
          <h2 data-reveal style="--delay:80ms">{effectiveness.heading}</h2>
          <div class="prose" data-reveal style="--delay:160ms">
            <RichText value={effectiveness.body} />
          </div>
          <p class="effect__flag" data-reveal style="--delay:240ms">{effectiveness.flag}</p>
        </div>
      </div>
    </section>

    <!-- ============================================ RECOVERY — full bleed -->
    <section class="bleed" id="recovery">
      <div class="bleed__media">
        <SanityImage image={recovery.image} widths={[1200, 1800, 2600]} sizes="100vw" quality={78} />
      </div>
      <div class="bleed__scrim"></div>
      <div class="wrap bleed__inner">
        <p class="tag tag--pale" data-reveal>{recovery.eyebrow}</p>
        <h2 data-reveal style="--delay:80ms">{recovery.heading}</h2>
        <ol class="rec" data-reveal style="--delay:160ms">
          {
            (recovery.items as { when: string; what: string }[]).map((r) => (
              <li><span class="rec__when">{r.when}</span><span class="rec__what">{r.what}</span></li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- ============================================ RISKS -->
    <section class="band risks" id="risks">
      <div class="wrap risks__inner">
        <div class="risks__head">
          <p class="tag" data-reveal>{risks.eyebrow}</p>
          <h2 data-reveal style="--delay:80ms">{risks.heading}</h2>
          <p class="lede" data-reveal style="--delay:160ms">{risks.lede}</p>
          <figure class="risks__figure" data-reveal style="--delay:240ms">
            <SanityImage
              image={risks.image}
              widths={[500, 800, 1100]}
              sizes="(min-width: 62rem) 34vw, 90vw"
              quality={78}
            />
          </figure>
        </div>

        <ul class="risk__list">
          {
            (risks.items as Risk[]).map((r, i) => (
              <li class="risk" data-reveal style={`--delay:${i * 70}ms`}>
                <div class="risk__top">
                  <h3 class="risk__name">{r.name}</h3>
                  <span class="risk__rate">{r.rate}</span>
                </div>
                <p class="risk__body">{r.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- ============================================ WHAT DOESN'T CHANGE -->
    <section class="band band--dark myths" id="unchanged">
      <div class="wrap myths__inner">
        <div class="myths__text">
          <p class="tag tag--pale" data-reveal>{unchanged.eyebrow}</p>
          <h2 data-reveal style="--delay:80ms">{unchanged.heading}</h2>
          <p class="lede" data-reveal style="--delay:160ms">{unchanged.lede}</p>
        </div>

        <div class="myths__list" data-reveal style="--delay:120ms">
          {
            (unchanged.items as Faq[]).map((u, i) => (
              <details class="acc" open={i === 0}>
                <summary>
                  <span class="acc__q">{u.q}</span>
                  <span class="acc__icon" aria-hidden="true" />
                </summary>
                <p class="acc__a">{u.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============================================ COST -->
    <section class="band cost" id="cost">
      <div class="wrap cost__inner">
        <div class="cost__text">
          <p class="tag" data-reveal>{cost.eyebrow}</p>
          <h2 data-reveal style="--delay:80ms">{cost.heading}</h2>
          <div class="prose" data-reveal style="--delay:160ms">
            <RichText value={cost.body} />
          </div>
          <div class="costbar" data-reveal style="--delay:240ms">
            {
              bars.map((b, i) => (
                <div class="costbar__row">
                  <span class="costbar__label">{b.label}</span>
                  <span class="costbar__track">
                    <span
                      class:list={["costbar__fill", i === 0 ? "costbar__fill--ours" : "costbar__fill--theirs"]}
                      style={`width:${barWidth(b)}`}
                    />
                  </span>
                  <span class="costbar__value">{b.value}</span>
                </div>
              ))
            }
          </div>
        </div>
        <figure class="cost__figure" data-reveal style="--delay:120ms">
          <SanityImage
            image={cost.image}
            widths={[500, 800, 1200]}
            sizes="(min-width: 62rem) 40vw, 90vw"
            quality={80}
          />
        </figure>
      </div>
    </section>

    <!-- ============================================ PERMANENCE -->
    <section class="band perm" id="permanence">
      <div class="wrap perm__inner">
        <div class="perm__bg" aria-hidden="true">
          <SanityImage image={permanence.background} widths={[1200, 2000]} sizes="100vw" quality={70} />
        </div>
        <div class="perm__content" data-reveal>
          <p class="tag">{permanence.eyebrow}</p>
          <h2>{permanence.heading}</h2>
          <p class="lede">{permanence.lede}</p>
          <p class="perm__note">{permanence.note}</p>
        </div>
      </div>
    </section>

    <!-- ============================================ LOCATIONS -->
    <section class="band locations" id="locations">
      <div class="wrap">
        <div class="locations__head" data-reveal>
          <p class="tag">{locations.eyebrow}</p>
          <h2>{locations.heading}</h2>
          <p class="lede">{locations.lede}</p>
        </div>
        <LocationFinder />
      </div>
    </section>

    <ReferBand />
  </main>

  <Footer />
</Base>

<script>
  // Horizontal appointment track
  const track = document.querySelector<HTMLElement>("[data-appt]");
  const prev = document.querySelector<HTMLButtonElement>("[data-appt-prev]");
  const next = document.querySelector<HTMLButtonElement>("[data-appt-next]");

  if (track && prev && next) {
    const step = () => {
      const card = track.querySelector<HTMLElement>(".appt__card");
      return card ? card.getBoundingClientRect().width + 20 : track.clientWidth * 0.8;
    };
    prev.addEventListener("click", () => track.scrollBy({ left: -step(), behavior: "smooth" }));
    next.addEventListener("click", () => track.scrollBy({ left: step(), behavior: "smooth" }));

    const sync = () => {
      const max = track.scrollWidth - track.clientWidth - 4;
      prev.disabled = track.scrollLeft <= 4;
      next.disabled = track.scrollLeft >= max;
    };
    sync();
    track.addEventListener("scroll", sync, { passive: true });
    window.addEventListener("resize", sync);
  }
</script>

<style>
  .vas__reg {
    background: var(--ink);
    padding-block: 1rem;
  }

  .vas__reg p {
    color: color-mix(in srgb, var(--drape-pale) 82%, transparent);
    font-family: var(--mono);
    font-size: 0.68rem;
    line-height: 1.6;
    letter-spacing: 0.06em;
  }

  /* ---------------------------------------------------- FACT STRIP */
  .factstrip {
    background: var(--ink);
    color: var(--bone);
    border-top: 1px solid color-mix(in srgb, var(--bone) 15%, transparent);
  }

  .factstrip__inner {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
  }

  .fact {
    display: grid;
    gap: 0.25rem;
    padding: 1.2rem 0;
    border-top: 1px solid color-mix(in srgb, var(--bone) 10%, transparent);
  }

  .fact:nth-child(-n + 2) {
    border-top: 0;
  }

  .fact__figure {
    font-family: var(--display);
    font-size: clamp(1.3rem, 1rem + 1vw, 1.9rem);
    font-weight: 600;
    font-variation-settings: "opsz" 40, "SOFT" 20, "WONK" 0;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .fact__label {
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--drape-pale);
  }

  @media (min-width: 48rem) {
    .factstrip__inner {
      grid-template-columns: repeat(5, 1fr);
      gap: clamp(1rem, 3vw, 3rem);
    }
    .fact {
      border-top: 0;
      padding: 1.5rem 0;
    }
  }

  /* ---------------------------------------------------- shared prose */
  .prose {
    display: grid;
    gap: 1.1rem;
    margin-top: 1.5rem;
    max-width: 48ch;
    color: var(--ink-soft);
  }

  .band--dark .prose,
  .band--drape .prose {
    color: var(--drape-pale);
  }

  /* ---------------------------------------------------- WHAT IS */
  .whatis__inner {
    display: grid;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: start;
  }

  .whatis__text h2 {
    margin-top: 0.4em;
    max-width: 17ch;
  }

  .whatis__figure {
    margin: 0;
    position: sticky;
    top: 7.5rem;
  }

  .whatis__figure :global(img) {
    width: 100%;
    border-radius: 2px;
  }

  .whatis__figure figcaption {
    margin-top: 0.85rem;
    max-width: 34ch;
  }

  @media (min-width: 62rem) {
    .whatis__inner {
      grid-template-columns: 1.05fr 0.95fr;
    }
  }

  /* ---------------------------------------------------- COMPARE */
  .compare__head h2 {
    margin-top: 0.4em;
    max-width: 16ch;
  }

  .cmp {
    display: grid;
    gap: 1.5rem;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .cmp__col {
    padding: clamp(1.4rem, 3vw, 2.2rem);
    border-radius: 3px;
    border: 1px solid color-mix(in srgb, var(--bone) 18%, transparent);
  }

  .cmp__col--new {
    background: color-mix(in srgb, var(--ink) 40%, transparent);
    border-color: color-mix(in srgb, var(--iodine-bright) 45%, transparent);
  }

  .cmp__label {
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--drape-pale);
    padding-bottom: 1rem;
    border-bottom: 1px solid color-mix(in srgb, var(--bone) 16%, transparent);
  }

  .cmp__col--new .cmp__label {
    color: var(--iodine-bright);
  }

  .cmp__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .cmp__list li {
    position: relative;
    padding: 0.75rem 0 0.75rem 1.5rem;
    font-size: 0.97rem;
    border-bottom: 1px solid color-mix(in srgb, var(--bone) 9%, transparent);
  }

  .cmp__list li:last-child {
    border-bottom: 0;
  }

  .cmp__list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 1.25rem;
    width: 7px;
    height: 9px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--drape-pale) 55%, transparent);
  }

  .cmp__col--new .cmp__list li::before {
    background: var(--iodine-bright);
  }

  .cmp__foot {
    margin-top: 2rem;
    font-family: var(--mono);
    font-size: 0.78rem;
    line-height: 1.7;
    color: var(--drape-pale);
    max-width: 50ch;
  }

  @media (min-width: 55rem) {
    .cmp {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* ---------------------------------------------------- OCCLUSION WRAP */
  .occwrap {
    background: var(--bone-pure);
  }

  .occwrap__head {
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .occwrap__head h2 {
    margin-top: 0.4em;
    max-width: 16ch;
  }

  .occwrap__head .lede {
    margin-top: 1.2rem;
    max-width: 50ch;
  }

  /* ---------------------------------------------------- APPOINTMENT */
  .appt__head {
    display: grid;
    gap: 1.4rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .appt__head h2 {
    margin-top: 0.4em;
  }

  .appt__intro {
    max-width: 40ch;
  }

  .appt__track {
    display: flex;
    gap: 1.25rem;
    padding-inline: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter)));
    scroll-padding-inline: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter)));
    padding-bottom: 1.25rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .appt__track::-webkit-scrollbar {
    display: none;
  }

  .appt__card {
    position: relative;
    flex: 0 0 min(21rem, 78vw);
    scroll-snap-align: start;
    padding: 1.6rem;
    background: color-mix(in srgb, var(--drape-deep) 42%, transparent);
    border: 1px solid color-mix(in srgb, var(--drape-pale) 20%, transparent);
    border-radius: 3px;
    overflow: hidden;
  }

  .appt__at {
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--iodine-bright);
  }

  .appt__rule {
    display: block;
    width: 2.2rem;
    height: 1px;
    background: color-mix(in srgb, var(--iodine-bright) 55%, transparent);
    margin: 0.9rem 0;
  }

  .appt__title {
    font-size: 1.2rem;
    line-height: 1.25;
  }

  .appt__body {
    margin-top: 0.7rem;
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--drape-pale);
  }

  .appt__n {
    position: absolute;
    right: 0.8rem;
    bottom: 0.2rem;
    font-family: var(--display);
    font-size: 3.4rem;
    font-weight: 600;
    line-height: 1;
    color: color-mix(in srgb, var(--bone) 6%, transparent);
    pointer-events: none;
  }

  .appt__controls {
    display: flex;
    gap: 0.6rem;
    margin-top: 1.6rem;
  }

  .appt__controls button {
    width: 2.9rem;
    height: 2.9rem;
    display: grid;
    place-items: center;
    font-size: 1rem;
    color: var(--bone);
    background: transparent;
    border: 1px solid color-mix(in srgb, var(--bone) 28%, transparent);
    border-radius: 50%;
    cursor: pointer;
    transition: background-color 0.3s var(--ease), opacity 0.3s var(--ease),
      border-color 0.3s var(--ease);
  }

  .appt__controls button:hover:not(:disabled) {
    background: color-mix(in srgb, var(--bone) 12%, transparent);
    border-color: var(--iodine-bright);
  }

  .appt__controls button:disabled {
    opacity: 0.3;
    cursor: default;
  }

  /* ---------------------------------------------------- EFFECTIVENESS */
  .effect__inner {
    display: grid;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
  }

  .effect__figure {
    margin: 0;
    border-radius: 2px;
    overflow: hidden;
  }

  .effect__figure :global(img) {
    width: 100%;
  }

  .effect__text h2 {
    margin-top: 0.4em;
    max-width: 17ch;
  }

  .effect__flag {
    margin-top: 1.8rem;
    padding: 1rem 1.2rem;
    background: color-mix(in srgb, var(--iodine) 10%, transparent);
    border-left: 2px solid var(--iodine);
    border-radius: 0 3px 3px 0;
    font-size: 0.94rem;
    font-weight: 500;
    max-width: 44ch;
  }

  @media (min-width: 62rem) {
    .effect__inner {
      grid-template-columns: 0.95fr 1.05fr;
    }
  }

  /* ---------------------------------------------------- BLEED / RECOVERY */
  .bleed {
    position: relative;
    display: flex;
    align-items: flex-end;
